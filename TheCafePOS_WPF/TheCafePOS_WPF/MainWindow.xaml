<Window x:Class="TheCafePOS_WPF.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:touch="clr-namespace:TheCafePOS_WPF.Core"
 Title="TheCafePOS — Bán hàng" Width="1240" Height="780" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F3F5F4" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#123D35" Padding="20,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="TheCafePOS" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
    <TextBlock x:Name="TxtNextOrderNumber" Foreground="#D0ECE1" Margin="18,0" VerticalAlignment="Center" FontWeight="Bold"/>
    <TextBlock x:Name="TxtSupabaseStatus" Text="Dữ liệu tại máy" Foreground="#D0ECE1" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="BtnHeldOrders" Content="Đơn giữ" Margin="0,0,8,0" Click="BtnHeldOrders_Click"/>
    <Button Content="Kho bao bì" Margin="0,0,8,0" Click="BtnPackaging_Click"/>
    <Button x:Name="UtilitiesButton" Content="Tiện ích ▾" Click="Utilities_Click"/>
   </StackPanel>
   <Popup x:Name="UtilitiesPopup" PlacementTarget="{Binding ElementName=UtilitiesButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
    <Border Background="#F3F5F4" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="16" Padding="18" Width="530">
     <StackPanel><TextBlock Text="Không gian làm việc" Style="{StaticResource SectionTitle}"/><Border Background="#E5EFE9" CornerRadius="8" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="TxtSession" TextWrapping="Wrap" Foreground="#123D35"/></Border>
      <TextBlock Text="CA LÀM VIỆC" Style="{StaticResource Hint}" Margin="4,0,0,4"/>
      <UniformGrid Columns="2"><Button Click="OpenShift_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Mở ca" FontSize="16" FontWeight="Bold"/><TextBlock Text="Nhập tiền mặt đầu ca" FontSize="12" Foreground="#52665F" Margin="0,5,0,0"/></StackPanel></Button><Button Click="BtnBlindDrop_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Chốt ca" FontSize="16" FontWeight="Bold"/><TextBlock Text="Đếm tiền và đối soát" FontSize="12" Foreground="#52665F" Margin="0,5,0,0"/></StackPanel></Button></UniformGrid>
      <TextBlock Text="VẬN HÀNH CỬA HÀNG" Style="{StaticResource Hint}" Margin="4,12,0,4"/>
      <UniformGrid Columns="2"><Button Click="Finance_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Hoàn tiền / Thu chi" FontSize="16" FontWeight="Bold"/><TextBlock Text="Quản lý tiền trong ca" FontSize="12" Foreground="#52665F" Margin="0,5,0,0"/></StackPanel></Button><Button x:Name="BtnReports" Click="Reports_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Báo cáo" FontSize="16" FontWeight="Bold"/><TextBlock Text="Doanh thu và đối soát" FontSize="12" Foreground="#52665F" Margin="0,5,0,0"/></StackPanel></Button><Button x:Name="BtnManagement" Click="Management_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Quản trị" FontSize="16" FontWeight="Bold"/><TextBlock Text="Thực đơn và nhân viên" FontSize="12" Foreground="#52665F" Margin="0,5,0,0"/></StackPanel></Button><Button Click="ChangePassword_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Đổi mật khẩu" FontSize="16" FontWeight="Bold"/><TextBlock Text="Bảo vệ tài khoản" FontSize="12" Foreground="#52665F" Margin="0,5,0,0"/></StackPanel></Button></UniformGrid>
      <Button Content="Đăng xuất / Đổi nhân viên" Style="{StaticResource DangerButton}" Click="SwitchUser_Click" Margin="4,16,4,4"/>
     </StackPanel>
    </Border>
   </Popup>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430" MinWidth="410"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="16" Padding="16" Margin="0,0,16,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="Thực đơn" FontSize="20" FontWeight="Bold" Foreground="#183D34"/><TextBlock x:Name="TxtProductCount" Foreground="#52665F" FontSize="12"/></StackPanel>
      <Grid Grid.Column="1"><TextBox x:Name="TxtSearch" AutomationProperties.Name="Tìm món theo tên" TextChanged="TxtSearch_TextChanged"/><TextBlock x:Name="TxtSearchPlaceholder" Text="Tìm tên món…" Foreground="#52665F" FontSize="15" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text.Length, ElementName=TxtSearch}" Value="0"/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TxtSearch}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Button Grid.Column="2" Content="×" FontSize="22" Width="48" MinWidth="48" Padding="0" ToolTip="Xóa tìm kiếm" AutomationProperties.Name="Xóa tìm kiếm" Click="BtnClearSearch_Click" Margin="6,0,0,0"/>
     </Grid>
     <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="PreviousCategories" Content="‹" Width="48" MinWidth="48" Padding="0" FontSize="24" Margin="0,0,6,0" Click="PreviousCategories_Click" ToolTip="Danh mục trước" AutomationProperties.Name="Cuộn danh mục sang trái"/>
      <ScrollViewer x:Name="CategoryScroller" Grid.Column="1" ClipToBounds="True" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" ScrollChanged="CategoryScroller_ScrollChanged" PreviewMouseWheel="CategoryScroller_PreviewMouseWheel"><StackPanel x:Name="PnlCategories" Orientation="Horizontal"/></ScrollViewer>
      <Button x:Name="NextCategories" Grid.Column="2" Content="›" Width="48" MinWidth="48" Padding="0" FontSize="24" Margin="6,0,0,0" Click="NextCategories_Click" ToolTip="Danh mục tiếp theo" AutomationProperties.Name="Cuộn danh mục sang phải"/>
     </Grid>
     <Grid Grid.Row="2"><ScrollViewer x:Name="ProductScroller" SizeChanged="ProductScroller_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><WrapPanel x:Name="PnlProducts"/></ScrollViewer>
<StackPanel x:Name="PnlNoProducts" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"><TextBlock Text="Không tìm thấy món" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Thử tên khác hoặc chọn danh mục Tất cả." Foreground="#52665F" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/><Button Content="Xem tất cả món" Click="ResetProductFilter_Click" HorizontalAlignment="Center"/></StackPanel></Grid>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Xóa đơn" Click="BtnClearCart_Click" Background="#FEE2E2" Foreground="#B91C1C"/>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtCartTitle" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="TxtCartTime" Foreground="#64748B"/></StackPanel>
     </DockPanel>
     <Grid Grid.Row="1"><StackPanel x:Name="PnlEmptyCart" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Chưa có món trong đơn" Foreground="#64748B" FontSize="17"/><TextBlock Text="Chạm món bên trái để thêm" Foreground="#52665F" Margin="0,6"/></StackPanel>
      <ListBox x:Name="LbCartItems" BorderThickness="0" HorizontalContentAlignment="Stretch" Background="Transparent" ScrollViewer.PanningMode="VerticalOnly">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Border Background="#F7F9F8" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10"><StackPanel>
        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding OptionsSummary}" FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4"/>
        <DockPanel Margin="0,2,0,6"><TextBlock Text="{Binding FormattedTotalPrice}" Foreground="#12634B" FontWeight="Bold"/><TextBlock Text="{Binding Quantity, StringFormat='Số lượng: {0}'}" HorizontalAlignment="Right"/></DockPanel>
        <UniformGrid Columns="5"><Button Content="Sửa" Margin="2" Padding="4" Tag="{Binding}" Click="EditCartItem_Click"/><Button Content="Tách 1" Margin="2" Padding="4" Tag="{Binding}" Click="SplitCartItem_Click"/>
         <Button Content="−" FontSize="22" Margin="2" Padding="4" Tag="{Binding}" Click="BtnMinusItem_Click" ToolTip="Giảm số lượng"/>
         <Button Content="+" FontSize="22" Margin="2" Padding="4" Tag="{Binding}" Click="BtnPlusItem_Click" ToolTip="Tăng số lượng"/>
         <Button Content="Xóa" Background="#FEE2E2" Foreground="#B91C1C" Margin="2" Padding="4" Tag="{Binding}" Click="BtnDeleteItem_Click"/>
        </UniformGrid>
       </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <StackPanel Grid.Row="2" Margin="0,12,0,12"><Border Height="1" Background="#DCE5DF" Margin="0,0,0,12"/>
      <DockPanel Margin="0,0,0,8"><TextBlock x:Name="TxtItemCountSummary" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="TxtGrandTotal" FontSize="30" FontWeight="Bold" Foreground="#12634B" HorizontalAlignment="Right"/></DockPanel>
      <UniformGrid x:Name="GridCashShortcuts" Columns="5" Margin="0,0,0,8">
       <Button Content="Đúng số" Tag="0" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="50k" Tag="50000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="100k" Tag="100000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="200k" Tag="200000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="500k" Tag="500000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/>
      </UniformGrid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="Tiền khách đưa" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox x:Name="TxtCashGiven" touch:TouchInput.Label="Tiền khách đưa" AutomationProperties.Name="Tiền khách đưa" touch:TouchInput.Numeric="True" TextChanged="TxtCashGiven_TextChanged" FontSize="18"/></StackPanel>
       <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Tiền thối lại" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="TxtChangeReturned" FontSize="20" FontWeight="Bold" Foreground="#12634B" TextWrapping="Wrap"/></StackPanel>
      </Grid>
     </StackPanel>
     <UniformGrid Grid.Row="3" Columns="3"><Button x:Name="BtnHold" Content="Giữ đơn" Margin="0,0,6,0" MinHeight="56" Click="BtnHoldOrder_Click"/><Button x:Name="BtnQr" Content="VietQR" Background="#E8F2ED" Foreground="#123D35" FontWeight="Bold" MinHeight="56" Margin="0,0,6,0" Click="BtnPayVietQR_Click"/><Button x:Name="BtnCash" Content="Tiền mặt" Background="#12634B" Foreground="White" FontWeight="Bold" MinHeight="56" Click="BtnPayCash_Click"/></UniformGrid>
    </Grid>
   </Border>
  </Grid>
  <Expander Grid.Row="2" Background="White" IsExpanded="False" Margin="16,0,16,8"><Expander.Header><TextBlock Text="Nhật ký tem / In lại" Padding="8,12" FontWeight="SemiBold"/></Expander.Header>
   <ListView x:Name="LvRecentStickers" Height="180"><ListView.View><GridView>
    <GridViewColumn Header="Đơn" DisplayMemberBinding="{Binding DailyOrderFormatted}" Width="80"/><GridViewColumn Header="Món" DisplayMemberBinding="{Binding ProductName}" Width="210"/><GridViewColumn Header="Tùy chọn" DisplayMemberBinding="{Binding OptionsSummary}" Width="330"/><GridViewColumn Header="Tem" DisplayMemberBinding="{Binding IndexFormatted}" Width="90"/><GridViewColumn Header="Giờ" DisplayMemberBinding="{Binding PrintTime, StringFormat=HH:mm:ss}" Width="100"/><GridViewColumn Header="Thao tác" Width="110"><GridViewColumn.CellTemplate><DataTemplate><Button Content="In lại" Tag="{Binding}" Click="BtnReprintSticker_Click" Padding="12,6"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
   </GridView></ListView.View></ListView>
  </Expander>
 </Grid>
</Window>

