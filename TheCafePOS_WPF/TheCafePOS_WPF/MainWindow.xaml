<Window xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="TheCafePOS_WPF.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:touch="clr-namespace:TheCafePOS_WPF.Core"
 Title="TheCafePOS — Bán hàng" Width="1240" Height="780" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource PosCanvas}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{StaticResource PosAccentDark}" Padding="20,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="TxtBrand" Text="TheCafePOS" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/><Border Width="1" Height="32" Background="White" Opacity="0.25" Margin="16,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtClockTime" FontSize="18" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="TxtClockDate" FontSize="12" Foreground="White" Opacity="0.75"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="BtnHeldOrders" Content="Đơn giữ (F9)" Margin="0,0,8,0" Click="BtnHeldOrders_Click"/>
    <Button x:Name="BtnQueue" Margin="0,0,8,0" Click="BtnQueue_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="CoffeeMaker" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Pha chế (F6)" VerticalAlignment="Center"/></StackPanel></Button><Button Margin="0,0,8,0" Click="BtnPackaging_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Kho bao bì" VerticalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="UtilitiesButton" Click="Utilities_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="ViewGridOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Tiện ích" VerticalAlignment="Center"/><md:PackIcon Kind="ChevronDown" Width="16" Height="16" VerticalAlignment="Center" Margin="4,0,0,0"/></StackPanel></Button>
   </StackPanel>
   <Popup x:Name="UtilitiesPopup" PlacementTarget="{Binding ElementName=UtilitiesButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
    <Border Background="{StaticResource PosCanvas}" BorderBrush="{StaticResource PosBorder}" BorderThickness="1" CornerRadius="16" Padding="18" Width="530">
     <StackPanel><TextBlock Text="Không gian làm việc" Style="{StaticResource SectionTitle}"/><Border Background="{StaticResource PosAccentSoft}" CornerRadius="8" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="TxtSession" TextWrapping="Wrap" Foreground="{StaticResource PosAccentDark}"/></Border>
      <TextBlock Text="Ca làm việc" Style="{StaticResource Hint}" Margin="4,0,0,4"/>
      <UniformGrid Columns="2"><Button Click="OpenShift_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Mở ca" FontSize="16" FontWeight="Bold"/><TextBlock Text="Nhập tiền mặt đầu ca" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button><Button Click="BtnBlindDrop_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Chốt ca" FontSize="16" FontWeight="Bold"/><TextBlock Text="Đếm tiền và đối soát" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button></UniformGrid>
      <TextBlock Text="VẬN HÀNH CỬA HÀNG" Style="{StaticResource Hint}" Margin="4,12,0,4"/>
      <UniformGrid Columns="2"><Button Click="Finance_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Hoàn tiền / Thu chi" FontSize="16" FontWeight="Bold"/><TextBlock Text="Quản lý tiền trong ca" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button><Button x:Name="BtnReports" Click="Reports_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Báo cáo" FontSize="16" FontWeight="Bold"/><TextBlock Text="Doanh thu và đối soát" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button><Button x:Name="BtnManagement" Click="Management_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Quản trị" FontSize="16" FontWeight="Bold"/><TextBlock Text="Thực đơn và nhân viên" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button><Button Click="ChangePassword_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Đổi mật khẩu" FontSize="16" FontWeight="Bold"/><TextBlock Text="Bảo vệ tài khoản" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button></UniformGrid>
      <Button Content="Đăng xuất / Đổi nhân viên" Style="{StaticResource DangerButton}" Click="SwitchUser_Click" Margin="4,16,4,4"/>
     </StackPanel>
    </Border>
   </Popup>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430" MinWidth="410"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="16" Padding="16" Margin="0,0,16,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="Thực đơn" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PosInk}"/><TextBlock x:Name="TxtProductCount" Foreground="{StaticResource PosMuted}" FontSize="12"/></StackPanel>
      <Grid Grid.Column="1"><TextBox x:Name="TxtSearch" AutomationProperties.Name="Tìm món theo tên" ToolTip="Tìm món (F2)" TextChanged="TxtSearch_TextChanged"/><TextBlock x:Name="TxtSearchPlaceholder" Text="Tìm tên món…" Foreground="{StaticResource PosMuted}" FontSize="15" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text.Length, ElementName=TxtSearch}" Value="0"/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TxtSearch}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Button Grid.Column="2" Content="×" FontSize="22" Width="48" MinWidth="48" Padding="0" ToolTip="Xóa tìm kiếm" AutomationProperties.Name="Xóa tìm kiếm" Click="BtnClearSearch_Click" Margin="6,0,0,0"/>
     </Grid>
     <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="PreviousCategories" Content="‹" Width="48" MinWidth="48" Padding="0" FontSize="24" Margin="0,0,6,0" Click="PreviousCategories_Click" ToolTip="Danh mục trước" AutomationProperties.Name="Cuộn danh mục sang trái"/>
      <ScrollViewer x:Name="CategoryScroller" Grid.Column="1" ClipToBounds="True" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" ScrollChanged="CategoryScroller_ScrollChanged" PreviewMouseWheel="CategoryScroller_PreviewMouseWheel"><StackPanel x:Name="PnlCategories" Orientation="Horizontal"/></ScrollViewer>
      <Button x:Name="NextCategories" Grid.Column="2" Content="›" Width="48" MinWidth="48" Padding="0" FontSize="24" Margin="6,0,0,0" Click="NextCategories_Click" ToolTip="Danh mục tiếp theo" AutomationProperties.Name="Cuộn danh mục sang phải"/>
     </Grid>
     <Grid Grid.Row="2"><ScrollViewer x:Name="ProductScroller" SizeChanged="ProductScroller_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><WrapPanel x:Name="PnlProducts"/></ScrollViewer>
<StackPanel x:Name="PnlNoProducts" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"><TextBlock Text="Không tìm thấy món" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Thử tên khác hoặc chọn danh mục Tất cả." Foreground="{StaticResource PosMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/><Button Content="Xem tất cả món" Click="ResetProductFilter_Click" HorizontalAlignment="Center"/></StackPanel></Grid>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><DockPanel Margin="0,0,0,8"><Button x:Name="BtnClearCart" DockPanel.Dock="Right" Click="BtnClearCart_Click" Background="{StaticResource PosDangerSoft}" Foreground="{StaticResource PosDanger}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="TrashCanOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Xóa đơn" VerticalAlignment="Center"/></StackPanel></Button>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtCartTitle" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="TxtCartTime" Foreground="{StaticResource PosMuted}"/></StackPanel>
     </DockPanel>
     <Border x:Name="CheckoutNotice" Background="{StaticResource PosWarningSoft}" CornerRadius="8" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
      <StackPanel><TextBlock x:Name="TxtCheckoutNotice" Foreground="{StaticResource PosWarningInk}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
       <Button x:Name="BtnOpenShiftHint" Content="Mở ca ngay" Click="OpenShift_Click" MinHeight="40" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"/>
      </StackPanel>
     </Border></StackPanel>
     <Grid Grid.Row="1"><StackPanel x:Name="PnlEmptyCart" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Chưa có món trong đơn" Foreground="{StaticResource PosMuted}" FontSize="17"/><TextBlock Text="Chạm món bên trái để thêm" Foreground="{StaticResource PosMuted}" Margin="0,6"/></StackPanel>
      <ListBox x:Name="LbCartItems" BorderThickness="0" HorizontalContentAlignment="Stretch" Background="Transparent" ScrollViewer.PanningMode="VerticalOnly">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource PosSubtle}" BorderBrush="{StaticResource PosBorder}" BorderThickness="1" CornerRadius="8" Padding="8,6">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Tag="{Binding}" Click="EditCartItem_Click" Background="Transparent" BorderThickness="0" Padding="2" MinHeight="0" HorizontalContentAlignment="Stretch" Cursor="Hand" ToolTip="Bấm để sửa món" AutomationProperties.Name="{Binding ProductName, StringFormat='Sửa {0}'}">
         <StackPanel><TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{Binding OptionsSummary}" FontSize="12" Foreground="{StaticResource PosMuted}" TextWrapping="Wrap" Margin="0,2"/><TextBlock Text="{Binding FormattedTotalPrice}" Foreground="{StaticResource PosAccent}" FontWeight="Bold" FontSize="13"/></StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
         <Button Width="40" Height="40" MinWidth="40" MinHeight="40" Padding="0" Tag="{Binding}" Click="BtnMinusItem_Click" ToolTip="Giảm số lượng" AutomationProperties.Name="{Binding ProductName, StringFormat='Giảm {0}'}"><md:PackIcon Kind="Minus" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
         <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
         <Button Width="40" Height="40" MinWidth="40" MinHeight="40" Padding="0" Tag="{Binding}" Click="BtnPlusItem_Click" ToolTip="Tăng số lượng" AutomationProperties.Name="{Binding ProductName, StringFormat='Tăng {0}'}"><md:PackIcon Kind="Plus" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
        </StackPanel>
        <Button Grid.Column="2" Width="40" Height="40" MinWidth="40" MinHeight="40" Padding="0" Background="{StaticResource PosDangerSoft}" Foreground="{StaticResource PosDanger}" Tag="{Binding}" Click="BtnDeleteItem_Click" ToolTip="Xóa món" AutomationProperties.Name="{Binding ProductName, StringFormat='Xóa {0}'}"><md:PackIcon Kind="TrashCanOutline" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
        <Button Grid.Column="3" Width="32" Height="40" MinWidth="32" MinHeight="40" Padding="0" Margin="4,0,0,0" Tag="{Binding}" Click="CartItemMore_Click" ToolTip="Thao tác khác" AutomationProperties.Name="{Binding ProductName, StringFormat='Thao tác khác cho {0}'}"><md:PackIcon Kind="DotsVertical" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
       </Grid></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <StackPanel x:Name="PnlCheckout" Grid.Row="2" Margin="0,12,0,12">
      <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="ChannelPicker" MinHeight="38" FontSize="14" Margin="0,0,6,0" ToolTip="Kênh bán" SelectionChanged="ChannelPicker_SelectionChanged"/>
       <StackPanel x:Name="ServiceTypeRow" Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnTakeAway" MinHeight="38" Padding="10,2" Margin="0,0,4,0" Click="ServiceType_Click" Tag="Mang đi"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="ShoppingOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Mang đi" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="BtnDineIn" MinHeight="38" Padding="10,2" Click="ServiceType_Click" Tag="Tại chỗ"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="Coffee" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Tại chỗ" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
      </Grid>
      <UniformGrid Columns="2" Margin="-2,0,-2,6"><Button x:Name="BtnCustomer" Content="Thành viên" MinHeight="38" Margin="2" Click="BtnCustomer_Click"/><Button x:Name="BtnDiscount" Content="＋ Giảm giá" MinHeight="38" Margin="2" Click="BtnDiscount_Click"/></UniformGrid>
      <StackPanel x:Name="PnlAdjustments" Margin="0,0,0,4"><TextBlock x:Name="TxtCustomerLine" Foreground="{StaticResource PosAccent}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TxtSubtotalLine" Foreground="{StaticResource PosMuted}"/><TextBlock x:Name="TxtChannelLine" Foreground="{StaticResource PosInfo}" FontWeight="SemiBold" Visibility="Collapsed"/><TextBlock x:Name="TxtPromoLine" Foreground="{StaticResource PosWarning}" FontWeight="SemiBold" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TxtLoyaltyLine" Foreground="{StaticResource PosDanger}" FontWeight="SemiBold" Visibility="Collapsed"/><TextBlock x:Name="TxtDiscountLine" Foreground="{StaticResource PosDanger}" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap"/></StackPanel>
      <DockPanel><TextBlock x:Name="TxtItemCountSummary" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="TxtGrandTotal" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PosAccent}" HorizontalAlignment="Right"/></DockPanel>
      <!-- Cash entry lives in the cash payment dialog; these stay hidden so payment code can reuse them. -->
      <StackPanel x:Name="PnlCash" Visibility="Collapsed">
      <UniformGrid x:Name="GridCashShortcuts" Columns="5" Margin="0,0,0,8">
       <Button Content="Đúng số" Tag="0" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="50k" Tag="50000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="100k" Tag="100000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="200k" Tag="200000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="500k" Tag="500000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/>
      </UniformGrid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="Tiền khách đưa" Foreground="{StaticResource PosMuted}" FontSize="12" Margin="0,0,0,4"/><TextBox x:Name="TxtCashGiven" touch:TouchInput.Label="Tiền khách đưa" AutomationProperties.Name="Tiền khách đưa" touch:TouchInput.Numeric="True" TextChanged="TxtCashGiven_TextChanged" FontSize="18"/></StackPanel>
       <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Tiền thối lại" Foreground="{StaticResource PosMuted}" FontSize="12"/><TextBlock x:Name="TxtChangeReturned" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PosAccent}" TextWrapping="Wrap"/></StackPanel>
      </Grid></StackPanel>
     </StackPanel>
     <UniformGrid x:Name="PnlPayButtons" Grid.Row="3" Columns="3"><Button x:Name="BtnHold" Padding="6,8" Margin="0,0,6,0" MinHeight="56" Click="BtnHoldOrder_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="PauseCircleOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Giữ đơn (F8)" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="BtnQr" Padding="6,8" Background="{StaticResource PosAccentSoft}" Foreground="{StaticResource PosAccentDark}" FontWeight="Bold" MinHeight="56" Margin="0,0,6,0" Click="BtnPayVietQR_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="Qrcode" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="VietQR (F5)" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="BtnCash" Padding="6,8" Content="Tiền mặt (F4)" Background="{StaticResource PosAccent}" Foreground="White" FontWeight="Bold" MinHeight="56" Click="BtnPayCash_Click"/></UniformGrid>
    </Grid>
   </Border>
  </Grid>
  <Expander Grid.Row="2" Background="White" IsExpanded="False" Margin="16,0,16,8"><Expander.Header><TextBlock Text="Nhật ký tem / In lại" Padding="8,12" FontWeight="SemiBold"/></Expander.Header>
   <ListView x:Name="LvRecentStickers" Height="180"><ListView.View><GridView>
    <GridViewColumn Header="Đơn" DisplayMemberBinding="{Binding DailyOrderFormatted}" Width="80"/><GridViewColumn Header="Món" DisplayMemberBinding="{Binding ProductName}" Width="210"/><GridViewColumn Header="Tùy chọn" DisplayMemberBinding="{Binding OptionsSummary}" Width="330"/><GridViewColumn Header="Tem" DisplayMemberBinding="{Binding IndexFormatted}" Width="90"/><GridViewColumn Header="Giờ" DisplayMemberBinding="{Binding PrintTime, StringFormat=HH:mm:ss}" Width="100"/><GridViewColumn Header="Thao tác" Width="110"><GridViewColumn.CellTemplate><DataTemplate><Button Content="In lại" Tag="{Binding}" Click="BtnReprintSticker_Click" Padding="12,6"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
   </GridView></ListView.View></ListView>
  </Expander>
 </Grid>
</Window>

