<Window xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="TheCafePOS_WPF.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:touch="clr-namespace:TheCafePOS_WPF.Core" xmlns:conv="clr-namespace:TheCafePOS_WPF.Core.Converters" xmlns:vm="clr-namespace:TheCafePOS_WPF.ViewModels"
 Title="TheCafePOS — Bán hàng" Width="1240" Height="780" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource PosCanvas}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  <conv:ProductImageConverter x:Key="ProductImage"/>
  <Style x:Key="CategoryChip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource PosBorderStrong}"/><Setter Property="Background" Value="{StaticResource PosSubtle}"/><Setter Property="Foreground" Value="{StaticResource PosInk}"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource PosAccent}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="MenuTileTemplate" DataType="{x:Type vm:MenuTile}">
   <Button x:Name="Tile" Style="{StaticResource ProductTile}" Click="ProductTile_Click" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding AutomationName}">
    <Button.ContextMenu><ContextMenu><MenuItem Header="{Binding SoldOutMenuText}" Click="ToggleSoldOut_Click"/></ContextMenu></Button.ContextMenu>
    <!-- The Border is the sizing host; ProductScroller_SizeChanged updates TileWidth. -->
    <Border x:Name="Card" Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="226">
     <Grid><Grid.RowDefinitions><RowDefinition x:Name="PhotoRow" Height="122"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="PhotoFrame" Background="{StaticResource PosSubtle}" CornerRadius="11,11,0,0"><Image x:Name="Photo" Source="{Binding ImageUrl, Converter={StaticResource ProductImage}}" Stretch="Uniform" Margin="10"/></Border>
      <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PosInk}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" Margin="12,10,12,0"/>
      <Grid Grid.Row="2" Margin="12,6,10,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding FormattedPrice}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PosAccent}"/>
        <TextBlock x:Name="Meta" Text="{Binding MetaText}" FontSize="12" Foreground="{StaticResource PosMuted}" Visibility="{Binding HasMeta, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock Text="Hết hàng" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PosDanger}" Visibility="{Binding IsSoldOut, Converter={StaticResource BoolToVisibility}}"/>
       </StackPanel>
       <Border x:Name="AddBadge" Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="{StaticResource PosAccent}" VerticalAlignment="Bottom"><md:PackIcon Kind="Plus" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
     </Grid>
    </Border>
   </Button>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Source, ElementName=Photo}" Value="{x:Null}"><Setter TargetName="PhotoFrame" Property="Visibility" Value="Collapsed"/><Setter TargetName="PhotoRow" Property="Height" Value="0"/><Setter TargetName="Card" Property="Height" Value="128"/></DataTrigger>
    <DataTrigger Binding="{Binding MetaStrikethrough}" Value="True"><Setter TargetName="Meta" Property="TextDecorations" Value="Strikethrough"/></DataTrigger>
    <!-- Sold-out items stay visible (dimmed) so the cashier can tell the customer right away. -->
    <DataTrigger Binding="{Binding IsSoldOut}" Value="True"><Setter TargetName="Tile" Property="Opacity" Value="0.6"/><Setter TargetName="AddBadge" Property="Background" Value="{StaticResource PosBorder}"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <!-- Tag carries the "is selected" flag so both service type buttons share one style. -->
  <Style x:Key="ServiceTypeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource PosInk}"/><Setter Property="FontWeight" Value="Normal"/>
   <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="{StaticResource PosAccent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{StaticResource PosAccentDark}" Padding="20,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="TxtBrand" Text="TheCafePOS" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/><Border Width="1" Height="32" Background="White" Opacity="0.25" Margin="16,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtClockTime" FontSize="18" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="TxtClockDate" FontSize="12" Foreground="White" Opacity="0.75"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="BtnHeldOrders" Margin="0,0,8,0" Click="BtnHeldOrders_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="ClipboardClockOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding HeldOrdersText}" VerticalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="BtnQueue" Margin="0,0,8,0" Click="BtnQueue_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="CoffeeMaker" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Pha chế (F6)" VerticalAlignment="Center"/></StackPanel></Button><Button Margin="0,0,8,0" Click="BtnPackaging_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Kho bao bì" VerticalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="UtilitiesButton" Click="Utilities_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="ViewGridOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Tiện ích" VerticalAlignment="Center"/><md:PackIcon Kind="ChevronDown" Width="16" Height="16" VerticalAlignment="Center" Margin="4,0,0,0"/></StackPanel></Button>
   </StackPanel>
   <Popup x:Name="UtilitiesPopup" PlacementTarget="{Binding ElementName=UtilitiesButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
    <Border Background="{StaticResource PosCanvas}" BorderBrush="{StaticResource PosBorder}" BorderThickness="1" CornerRadius="16" Padding="18" Width="530">
     <StackPanel><TextBlock Text="Không gian làm việc" Style="{StaticResource SectionTitle}"/><Border Background="{StaticResource PosAccentSoft}" CornerRadius="8" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="TxtSession" TextWrapping="Wrap" Foreground="{StaticResource PosAccentDark}"/></Border>
      <TextBlock Text="Ca làm việc" Style="{StaticResource Hint}" Margin="4,0,0,4"/>
      <UniformGrid Columns="2"><Button Click="OpenShift_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Mở ca" FontSize="16" FontWeight="Bold"/><TextBlock Text="Nhập tiền mặt đầu ca" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button><Button Click="BtnBlindDrop_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Chốt ca" FontSize="16" FontWeight="Bold"/><TextBlock Text="Đếm tiền và đối soát" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button></UniformGrid>
      <TextBlock Text="VẬN HÀNH CỬA HÀNG" Style="{StaticResource Hint}" Margin="4,12,0,4"/>
      <UniformGrid Columns="2"><Button Click="Finance_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Hoàn tiền / Thu chi" FontSize="16" FontWeight="Bold"/><TextBlock Text="Quản lý tiền trong ca" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button><Button x:Name="BtnReports" Click="Reports_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Báo cáo" FontSize="16" FontWeight="Bold"/><TextBlock Text="Doanh thu và đối soát" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button><Button x:Name="BtnManagement" Click="Management_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Quản trị" FontSize="16" FontWeight="Bold"/><TextBlock Text="Thực đơn và nhân viên" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button><Button Click="ChangePassword_Click" Style="{StaticResource UtilityTile}"><StackPanel><TextBlock Text="Đổi mật khẩu" FontSize="16" FontWeight="Bold"/><TextBlock Text="Bảo vệ tài khoản" FontSize="12" Foreground="{StaticResource PosMuted}" Margin="0,5,0,0"/></StackPanel></Button></UniformGrid>
      <Button Content="Đăng xuất / Đổi nhân viên" Style="{StaticResource DangerButton}" Click="SwitchUser_Click" Margin="4,16,4,4"/>
     </StackPanel>
    </Border>
   </Popup>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430" MinWidth="410"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="16" Padding="16" Margin="0,0,16,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="Thực đơn" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PosInk}"/><TextBlock x:Name="TxtProductCount" Text="{Binding MenuCountText}" Foreground="{StaticResource PosMuted}" FontSize="12"/></StackPanel>
      <Grid Grid.Column="1"><TextBox x:Name="TxtSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tìm món theo tên" ToolTip="Tìm món (F2)"/><TextBlock x:Name="TxtSearchPlaceholder" Text="Tìm tên món…" Foreground="{StaticResource PosMuted}" FontSize="15" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text.Length, ElementName=TxtSearch}" Value="0"/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TxtSearch}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Button Grid.Column="2" Content="×" FontSize="22" Width="48" MinWidth="48" Padding="0" ToolTip="Xóa tìm kiếm" AutomationProperties.Name="Xóa tìm kiếm" Click="BtnClearSearch_Click" Margin="6,0,0,0"/>
     </Grid>
     <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="PreviousCategories" Content="‹" Width="48" MinWidth="48" Padding="0" FontSize="24" Margin="0,0,6,0" Click="PreviousCategories_Click" ToolTip="Danh mục trước" AutomationProperties.Name="Cuộn danh mục sang trái"/>
      <ScrollViewer x:Name="CategoryScroller" Grid.Column="1" ClipToBounds="True" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" ScrollChanged="CategoryScroller_ScrollChanged" PreviewMouseWheel="CategoryScroller_PreviewMouseWheel"><ItemsControl x:Name="PnlCategories" ItemsSource="{Binding CategoryList}" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CategoryOption}"><Button Content="{Binding Name}" Style="{StaticResource CategoryChip}" Click="CategoryButton_Click"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      <Button x:Name="NextCategories" Grid.Column="2" Content="›" Width="48" MinWidth="48" Padding="0" FontSize="24" Margin="6,0,0,0" Click="NextCategories_Click" ToolTip="Danh mục tiếp theo" AutomationProperties.Name="Cuộn danh mục sang phải"/>
     </Grid>
     <Grid Grid.Row="2"><ScrollViewer x:Name="ProductScroller" SizeChanged="ProductScroller_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><ItemsControl x:Name="PnlProducts" ItemsSource="{Binding MenuItems}" ItemTemplate="{StaticResource MenuTileTemplate}" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
<StackPanel x:Name="PnlNoProducts" Visibility="{Binding HasNoProducts, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"><TextBlock Text="Không tìm thấy món" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Thử tên khác hoặc chọn danh mục Tất cả." Foreground="{StaticResource PosMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/><Button Content="Xem tất cả món" Click="ResetProductFilter_Click" HorizontalAlignment="Center"/></StackPanel></Grid>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><DockPanel Margin="0,0,0,8"><Button x:Name="BtnClearCart" DockPanel.Dock="Right" Click="BtnClearCart_Click" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanEditCart}" Background="{StaticResource PosDangerSoft}" Foreground="{StaticResource PosDanger}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="TrashCanOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Xóa đơn" VerticalAlignment="Center"/></StackPanel></Button>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtCartTitle" Text="{Binding CartTitle}" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="TxtCartTime" Text="{Binding CartTimeText}" Foreground="{StaticResource PosMuted}"/></StackPanel>
     </DockPanel>
     <Border x:Name="CheckoutNotice" Background="{StaticResource PosWarningSoft}" CornerRadius="8" Padding="10" Margin="0,0,0,8" Visibility="{Binding HasCheckoutNotice, Converter={StaticResource BoolToVisibility}}">
      <StackPanel><TextBlock x:Name="TxtCheckoutNotice" Text="{Binding CheckoutNotice}" Foreground="{StaticResource PosWarningInk}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
       <Button x:Name="BtnOpenShiftHint" Content="Mở ca ngay" Click="OpenShift_Click" MinHeight="40" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding ShowOpenShiftHint, Converter={StaticResource BoolToVisibility}}"/>
      </StackPanel>
     </Border></StackPanel>
     <Grid Grid.Row="1"><StackPanel x:Name="PnlEmptyCart" Visibility="{Binding IsCartEmpty, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Chưa có món trong đơn" Foreground="{StaticResource PosMuted}" FontSize="17"/><TextBlock Text="Chạm món bên trái để thêm" Foreground="{StaticResource PosMuted}" Margin="0,6"/></StackPanel>
      <ListBox x:Name="LbCartItems" ItemsSource="{Binding CartItems}" IsEnabled="{Binding CanEditCart}" BorderThickness="0" HorizontalContentAlignment="Stretch" Background="Transparent" ScrollViewer.PanningMode="VerticalOnly">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource PosSubtle}" BorderBrush="{StaticResource PosBorder}" BorderThickness="1" CornerRadius="8" Padding="8,6">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Tag="{Binding}" Click="EditCartItem_Click" Background="Transparent" BorderThickness="0" Padding="2" MinHeight="0" HorizontalContentAlignment="Stretch" Cursor="Hand" ToolTip="Bấm để sửa món" AutomationProperties.Name="{Binding ProductName, StringFormat='Sửa {0}'}">
         <StackPanel><TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{Binding OptionsSummary}" FontSize="12" Foreground="{StaticResource PosMuted}" TextWrapping="Wrap" Margin="0,2"/><TextBlock Text="{Binding FormattedTotalPrice}" Foreground="{StaticResource PosAccent}" FontWeight="Bold" FontSize="13"/></StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
         <Button Width="40" Height="40" MinWidth="40" MinHeight="40" Padding="0" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Giảm số lượng" AutomationProperties.Name="{Binding ProductName, StringFormat='Giảm {0}'}"><md:PackIcon Kind="Minus" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
         <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
         <Button Width="40" Height="40" MinWidth="40" MinHeight="40" Padding="0" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Tăng số lượng" AutomationProperties.Name="{Binding ProductName, StringFormat='Tăng {0}'}"><md:PackIcon Kind="Plus" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
        </StackPanel>
        <Button Grid.Column="2" Width="40" Height="40" MinWidth="40" MinHeight="40" Padding="0" Background="{StaticResource PosDangerSoft}" Foreground="{StaticResource PosDanger}" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Xóa món" AutomationProperties.Name="{Binding ProductName, StringFormat='Xóa {0}'}"><md:PackIcon Kind="TrashCanOutline" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
        <Button Grid.Column="3" Width="32" Height="40" MinWidth="32" MinHeight="40" Padding="0" Margin="4,0,0,0" Tag="{Binding}" Click="CartItemMore_Click" ToolTip="Thao tác khác" AutomationProperties.Name="{Binding ProductName, StringFormat='Thao tác khác cho {0}'}"><md:PackIcon Kind="DotsVertical" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
       </Grid></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <StackPanel x:Name="PnlCheckout" Grid.Row="2" Margin="0,12,0,12" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanEditCart}">
      <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="ChannelPicker" MinHeight="38" FontSize="14" Margin="0,0,6,0" ToolTip="Kênh bán" ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding Channel}"/>
       <StackPanel x:Name="ServiceTypeRow" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding IsCounterOrder}"><Button x:Name="BtnTakeAway" Style="{StaticResource ServiceTypeButton}" MinHeight="38" Padding="10,2" Margin="0,0,4,0" Tag="{Binding IsTakeAway}" Command="{Binding SetServiceTypeCommand}" CommandParameter="Mang đi"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="ShoppingOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Mang đi" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="BtnDineIn" Style="{StaticResource ServiceTypeButton}" MinHeight="38" Padding="10,2" Tag="{Binding IsDineIn}" Command="{Binding SetServiceTypeCommand}" CommandParameter="Tại chỗ"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="Coffee" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Tại chỗ" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
      </Grid>
      <UniformGrid Columns="2" Margin="-2,0,-2,6"><Button x:Name="BtnCustomer" MinHeight="38" Margin="2" Click="BtnCustomer_Click" Visibility="{Binding IsCounterOrder, Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="AccountOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding CustomerButtonText}" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="BtnDiscount" MinHeight="38" Margin="2" Click="BtnDiscount_Click" IsEnabled="{Binding HasItems}" Visibility="{Binding IsCounterOrder, Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="TagOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding DiscountButtonText}" VerticalAlignment="Center"/></StackPanel></Button></UniformGrid>
      <StackPanel x:Name="PnlAdjustments" Margin="0,0,0,4"><TextBlock x:Name="TxtCustomerLine" Text="{Binding CustomerLine}" Visibility="{Binding ShowCustomerLine, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource PosAccent}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TxtSubtotalLine" Text="{Binding SubtotalLine}" Visibility="{Binding ShowSubtotalLine, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource PosMuted}"/><TextBlock x:Name="TxtChannelLine" Text="{Binding ChannelLine}" Visibility="{Binding IsAppOrder, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource PosInfo}" FontWeight="SemiBold"/><TextBlock x:Name="TxtPromoLine" Text="{Binding PromoLine}" Visibility="{Binding ShowPromoLine, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource PosWarning}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TxtLoyaltyLine" Text="{Binding LoyaltyLine}" Visibility="{Binding ShowLoyaltyLine, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource PosDanger}" FontWeight="SemiBold"/><TextBlock x:Name="TxtDiscountLine" Text="{Binding DiscountLine}" Visibility="{Binding ShowDiscountLine, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource PosDanger}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
      <DockPanel><TextBlock x:Name="TxtItemCountSummary" Text="{Binding ItemCountText}" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="TxtGrandTotal" Text="{Binding GrandTotalText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PosAccent}" HorizontalAlignment="Right"/></DockPanel>
     </StackPanel>
     <UniformGrid x:Name="PnlPayButtons" Grid.Row="3" Columns="3" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}"><Button x:Name="BtnHold" IsEnabled="{Binding CanPay}" Padding="6,8" Margin="0,0,6,0" MinHeight="56" Click="BtnHoldOrder_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="PauseCircleOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Giữ đơn (F8)" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="BtnQr" IsEnabled="{Binding CanPay}" Visibility="{Binding IsCounterOrder, Converter={StaticResource BoolToVisibility}}" Padding="6,8" Background="{StaticResource PosAccentSoft}" Foreground="{StaticResource PosAccentDark}" FontWeight="Bold" MinHeight="56" Margin="0,0,6,0" Click="BtnPayVietQR_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="Qrcode" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="VietQR (F5)" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="BtnCash" IsEnabled="{Binding CanPay}" Padding="6,8" Background="{StaticResource PosAccent}" Foreground="White" FontWeight="Bold" MinHeight="56" Click="BtnPayCash_Click"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="Cash" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding IsCounterOrder, Converter={StaticResource BoolToVisibility}}"/><md:PackIcon Kind="Moped" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding IsAppOrder, Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="{Binding CashButtonText}" VerticalAlignment="Center"/></StackPanel></Button></UniformGrid>
    </Grid>
   </Border>
  </Grid>
  <Expander Grid.Row="2" Background="White" IsExpanded="False" Margin="16,0,16,8"><Expander.Header><TextBlock Text="Nhật ký tem / In lại" Padding="8,12" FontWeight="SemiBold"/></Expander.Header>
   <ListView x:Name="LvRecentStickers" Height="180"><ListView.View><GridView>
    <GridViewColumn Header="Đơn" DisplayMemberBinding="{Binding DailyOrderFormatted}" Width="80"/><GridViewColumn Header="Món" DisplayMemberBinding="{Binding ProductName}" Width="210"/><GridViewColumn Header="Tùy chọn" DisplayMemberBinding="{Binding OptionsSummary}" Width="330"/><GridViewColumn Header="Tem" DisplayMemberBinding="{Binding IndexFormatted}" Width="90"/><GridViewColumn Header="Giờ" DisplayMemberBinding="{Binding PrintTime, StringFormat=HH:mm:ss}" Width="100"/><GridViewColumn Header="Thao tác" Width="110"><GridViewColumn.CellTemplate><DataTemplate><Button Content="In lại" Tag="{Binding}" Click="BtnReprintSticker_Click" Padding="12,6"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
   </GridView></ListView.View></ListView>
  </Expander>
 </Grid>
</Window>

