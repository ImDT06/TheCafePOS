<Window x:Class="TheCafePOS_WPF.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:touch="clr-namespace:TheCafePOS_WPF.Core"
 Title="TheCafePOS — Bán hàng" Width="1240" Height="780" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F1F5F9" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#1E293B" Padding="16,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="TheCafePOS" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
    <TextBlock x:Name="TxtNextOrderNumber" Foreground="#7DD3FC" Margin="18,0" VerticalAlignment="Center" FontWeight="Bold"/>
    <TextBlock x:Name="TxtSupabaseStatus" Text="Dữ liệu tại máy" Foreground="#CBD5E1" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="BtnHeldOrders" Content="Đơn giữ" Margin="0,0,8,0" Click="BtnHeldOrders_Click"/>
    <Button Content="Kho bao bì" Margin="0,0,8,0" Click="BtnPackaging_Click"/>
    <Button x:Name="UtilitiesButton" Content="Tiện ích ▾" Click="Utilities_Click"/>
   </StackPanel>
   <Popup x:Name="UtilitiesPopup" PlacementTarget="{Binding ElementName=UtilitiesButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16" Width="430">
     <StackPanel><TextBlock x:Name="TxtSession" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#334155"/>
      <UniformGrid Columns="2"><Button Content="Mở ca" Click="OpenShift_Click" Margin="4"/><Button Content="Chốt ca" Click="BtnBlindDrop_Click" Margin="4"/>
       <Button Content="Hoàn tiền / Thu chi" Click="Finance_Click" Margin="4"/><Button x:Name="BtnReports" Content="Báo cáo" Click="Reports_Click" Margin="4"/>
       <Button x:Name="BtnManagement" Content="Quản trị" Click="Management_Click" Margin="4"/><Button Content="Đổi mật khẩu" Click="ChangePassword_Click" Margin="4"/>
      </UniformGrid><Button Content="Đăng xuất / Đổi nhân viên" Click="SwitchUser_Click" Margin="4,8,4,4"/>
     </StackPanel>
    </Border>
   </Popup>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="58*"/><ColumnDefinition Width="42*" MinWidth="420"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,12,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Xóa tìm" Click="BtnClearSearch_Click" Margin="8,0,0,0"/><Grid>
      <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged"/>
      <TextBlock x:Name="TxtSearchPlaceholder" Text="Tìm tên món…" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0"/>
     </Grid></DockPanel>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" Margin="0,0,0,8"><StackPanel x:Name="PnlCategories" Orientation="Horizontal"/></ScrollViewer>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><WrapPanel x:Name="PnlProducts"/></ScrollViewer>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Xóa hết" Click="BtnClearCart_Click" Background="#FEE2E2" Foreground="#B91C1C"/>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtCartTitle" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="TxtCartTime" Foreground="#64748B"/></StackPanel>
     </DockPanel>
     <Grid Grid.Row="1"><StackPanel x:Name="PnlEmptyCart" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Chưa có món trong đơn" Foreground="#64748B" FontSize="17"/><TextBlock Text="Chạm món bên trái để thêm" Foreground="#94A3B8" Margin="0,6"/></StackPanel>
      <ListBox x:Name="LbCartItems" BorderThickness="0" HorizontalContentAlignment="Stretch" Background="Transparent" ScrollViewer.PanningMode="VerticalOnly">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10"><StackPanel>
        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding OptionsSummary}" FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4"/>
        <DockPanel Margin="0,2,0,6"><TextBlock Text="{Binding FormattedTotalPrice}" Foreground="#15803D" FontWeight="Bold"/><TextBlock Text="{Binding Quantity, StringFormat='Số lượng: {0}'}" HorizontalAlignment="Right"/></DockPanel>
        <UniformGrid Columns="5"><Button Content="Sửa" Margin="2" Padding="4" Tag="{Binding}" Click="EditCartItem_Click"/><Button Content="Tách 1" Margin="2" Padding="4" Tag="{Binding}" Click="SplitCartItem_Click"/>
         <Button Content="−" FontSize="22" Margin="2" Padding="4" Tag="{Binding}" Click="BtnMinusItem_Click" ToolTip="Giảm số lượng"/>
         <Button Content="+" FontSize="22" Margin="2" Padding="4" Tag="{Binding}" Click="BtnPlusItem_Click" ToolTip="Tăng số lượng"/>
         <Button Content="Xóa" Background="#FEE2E2" Foreground="#B91C1C" Margin="2" Padding="4" Tag="{Binding}" Click="BtnDeleteItem_Click"/>
        </UniformGrid>
       </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <StackPanel Grid.Row="2" Margin="0,8,0,8">
      <DockPanel Margin="0,0,0,8"><TextBlock x:Name="TxtItemCountSummary" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="TxtGrandTotal" FontSize="24" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Right"/></DockPanel>
      <UniformGrid x:Name="GridCashShortcuts" Columns="5" Margin="0,0,0,8">
       <Button Content="Đúng số" Tag="0" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="50k" Tag="50000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="100k" Tag="100000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="200k" Tag="200000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/><Button Content="500k" Tag="500000" Padding="4" Margin="2" Click="BtnCashShortcut_Click"/>
      </UniformGrid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="Khách đưa · chạm để nhập" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/><TextBox x:Name="TxtCashGiven" touch:TouchInput.Numeric="True" TextChanged="TxtCashGiven_TextChanged" FontSize="18"/></StackPanel>
       <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Tiền thối lại" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="TxtChangeReturned" FontSize="20" FontWeight="Bold" Foreground="#15803D" TextWrapping="Wrap"/></StackPanel>
      </Grid>
     </StackPanel>
     <UniformGrid Grid.Row="3" Columns="3"><Button Content="Giữ đơn" Margin="0,0,6,0" MinHeight="56" Click="BtnHoldOrder_Click"/><Button Content="VietQR" Background="#0284C7" Foreground="White" FontWeight="Bold" MinHeight="56" Margin="0,0,6,0" Click="BtnPayVietQR_Click"/><Button Content="Tiền mặt" Background="#16A34A" Foreground="White" FontWeight="Bold" MinHeight="56" Click="BtnPayCash_Click"/></UniformGrid>
    </Grid>
   </Border>
  </Grid>
  <Expander Grid.Row="2" Background="White" IsExpanded="False" Margin="12,0,12,8"><Expander.Header><TextBlock Text="Nhật ký tem / In lại" Padding="8,12" FontWeight="SemiBold"/></Expander.Header>
   <ListView x:Name="LvRecentStickers" Height="180"><ListView.View><GridView>
    <GridViewColumn Header="Đơn" DisplayMemberBinding="{Binding DailyOrderFormatted}" Width="80"/><GridViewColumn Header="Món" DisplayMemberBinding="{Binding ProductName}" Width="210"/><GridViewColumn Header="Tùy chọn" DisplayMemberBinding="{Binding OptionsSummary}" Width="330"/><GridViewColumn Header="Tem" DisplayMemberBinding="{Binding IndexFormatted}" Width="90"/><GridViewColumn Header="Giờ" DisplayMemberBinding="{Binding PrintTime, StringFormat=HH:mm:ss}" Width="100"/><GridViewColumn Header="Thao tác" Width="110"><GridViewColumn.CellTemplate><DataTemplate><Button Content="In lại" Tag="{Binding}" Click="BtnReprintSticker_Click" Padding="12,6"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
   </GridView></ListView.View></ListView>
  </Expander>
 </Grid>
</Window>

