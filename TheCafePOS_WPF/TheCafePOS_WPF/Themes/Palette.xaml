 <SolidColorBrush x:Key="PosAccentDark" Color="#123D35"/>
 <SolidColorBrush x:Key="PosAccentSoft" Color="#E8F2ED"/>
 <SolidColorBrush x:Key="PosSelected" Color="#DCEEE4"/>
 <SolidColorBrush x:Key="PosSubtle" Color="#F1F6F3"/>
