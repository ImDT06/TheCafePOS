 <SolidColorBrush x:Key="PosCanvas" Color="#F3F5F4"/>
 <SolidColorBrush x:Key="PosSurface" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="PosBorder" Color="#DFE7E2"/>
 <SolidColorBrush x:Key="PosBorderStrong" Color="#B8C8BF"/>
 <SolidColorBrush x:Key="PosDanger" Color="#B42318"/>
 <SolidColorBrush x:Key="PosDangerSoft" Color="#FFF1F0"/>
