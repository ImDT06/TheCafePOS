<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- The only place colours are defined: change a value here and XAML, code-built dialogs (Core/Palette.cs),
      shadows and the Material primary colour all follow. Hard-coded colours anywhere else are a bug. -->
 <Color x:Key="PosAccentColor">#4F46E5</Color>
 <Color x:Key="PosAccentDarkColor">#312E81</Color>
 <Color x:Key="PosAccentSoftColor">#EEF2FF</Color>
 <Color x:Key="PosSelectedColor">#E0E7FF</Color>
 <Color x:Key="PosSubtleColor">#F5F7FB</Color>
 <Color x:Key="PosInkColor">#1E293B</Color>
 <Color x:Key="PosMutedColor">#64748B</Color>
 <Color x:Key="PosCanvasColor">#F4F5FA</Color>
 <Color x:Key="PosSurfaceColor">#FFFFFF</Color>
 <Color x:Key="PosBorderColor">#E2E8F0</Color>
 <Color x:Key="PosBorderStrongColor">#CBD5E1</Color>
 <Color x:Key="PosDangerColor">#B42318</Color>
 <Color x:Key="PosDangerSoftColor">#FFF1F0</Color>
 <Color x:Key="PosDangerBorderColor">#F2C7C2</Color>
 <Color x:Key="PosWarningColor">#B45309</Color>
 <Color x:Key="PosWarningInkColor">#92400E</Color>
 <Color x:Key="PosWarningSoftColor">#FFF7ED</Color>
 <Color x:Key="PosWarningBorderColor">#FED7AA</Color>
 <Color x:Key="PosInfoColor">#0369A1</Color>
 <SolidColorBrush x:Key="PosAccent" Color="{StaticResource PosAccentColor}"/>
 <SolidColorBrush x:Key="PosAccentDark" Color="{StaticResource PosAccentDarkColor}"/>
 <SolidColorBrush x:Key="PosAccentSoft" Color="{StaticResource PosAccentSoftColor}"/>
 <SolidColorBrush x:Key="PosSelected" Color="{StaticResource PosSelectedColor}"/>
 <SolidColorBrush x:Key="PosSubtle" Color="{StaticResource PosSubtleColor}"/>
 <SolidColorBrush x:Key="PosInk" Color="{StaticResource PosInkColor}"/>
 <SolidColorBrush x:Key="PosMuted" Color="{StaticResource PosMutedColor}"/>
 <SolidColorBrush x:Key="PosCanvas" Color="{StaticResource PosCanvasColor}"/>
 <SolidColorBrush x:Key="PosSurface" Color="{StaticResource PosSurfaceColor}"/>
 <SolidColorBrush x:Key="PosBorder" Color="{StaticResource PosBorderColor}"/>
 <SolidColorBrush x:Key="PosBorderStrong" Color="{StaticResource PosBorderStrongColor}"/>
 <SolidColorBrush x:Key="PosDanger" Color="{StaticResource PosDangerColor}"/>
 <SolidColorBrush x:Key="PosDangerSoft" Color="{StaticResource PosDangerSoftColor}"/>
 <SolidColorBrush x:Key="PosDangerBorder" Color="{StaticResource PosDangerBorderColor}"/>
 <SolidColorBrush x:Key="PosWarning" Color="{StaticResource PosWarningColor}"/>
 <SolidColorBrush x:Key="PosWarningInk" Color="{StaticResource PosWarningInkColor}"/>
 <SolidColorBrush x:Key="PosWarningSoft" Color="{StaticResource PosWarningSoftColor}"/>
 <SolidColorBrush x:Key="PosWarningBorder" Color="{StaticResource PosWarningBorderColor}"/>
 <SolidColorBrush x:Key="PosInfo" Color="{StaticResource PosInfoColor}"/>
</ResourceDictionary>
