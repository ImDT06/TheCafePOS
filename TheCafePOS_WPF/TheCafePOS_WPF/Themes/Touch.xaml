<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:touch="clr-namespace:TheCafePOS_WPF.Core" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <ResourceDictionary.MergedDictionaries>
  <md:CustomColorTheme BaseTheme="Light" PrimaryColor="#12634B" SecondaryColor="#B45309"/>
  <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
  <ResourceDictionary Source="/TheCafePOS_WPF;component/Themes/Palette.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <!-- Material Design 3 controls; this file only adds touch sizing (48px targets) and the shop palette. -->
 <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
  <Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="48"/><Setter Property="MinWidth" Value="48"/><Setter Property="Padding" Value="12,8"/>
  <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Background" Value="{StaticResource PosSurface}"/><Setter Property="Foreground" Value="{StaticResource PosInk}"/><Setter Property="BorderBrush" Value="{StaticResource PosBorderStrong}"/>
  <Setter Property="md:ButtonAssist.CornerRadius" Value="8"/><Setter Property="md:RippleAssist.Feedback" Value="{StaticResource PosAccent}"/>
  <!-- MD's outlined template floods the button with the primary colour on hover, which hides dark text on our light buttons.
       Keep the ripple, but hover with a faint tint of the button's own text colour so every variant stays readable. -->
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid>
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
    <Border x:Name="HoverTint" Background="{TemplateBinding Foreground}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
    <md:Ripple Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" Focusable="False" Feedback="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" ClipToBounds="True"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverTint" Property="Opacity" Value="0.07"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverTint" Property="Opacity" Value="0.14"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosAccent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <DropShadowEffect x:Key="TileShadow" Color="#183D34" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.10"/>
 <DropShadowEffect x:Key="TileShadowRaised" Color="#183D34" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18"/>
 <!-- Menu item tile on the sales screen: raised white card that lifts and outlines on hover. -->
 <Style x:Key="ProductTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="{StaticResource PosSurface}"/><Setter Property="BorderBrush" Value="{StaticResource PosBorder}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid>
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Effect="{StaticResource TileShadow}"/>
    <md:Ripple Content="{TemplateBinding Content}" Focusable="False" Feedback="{StaticResource PosAccent}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosAccent}"/><Setter TargetName="Surface" Property="Effect" Value="{StaticResource TileShadowRaised}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosAccent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Effect" Value="{StaticResource TileShadow}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
  <Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Background" Value="{StaticResource PosSurface}"/><Setter Property="BorderBrush" Value="{StaticResource PosBorderStrong}"/><Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="8"/><Setter Property="md:HintAssist.Background" Value="{StaticResource PosSurface}"/><Setter Property="md:TextFieldAssist.OutlinedBorderActiveThickness" Value="1"/>
  <Style.Triggers>
   <!-- Money/quantity fields keep an explicit keypad button for touch screens. -->
   <Trigger Property="touch:TouchInput.Numeric" Value="True"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid><Border x:Name="InputSurface" Margin="0,8,0,0" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/><Button x:Name="NumberPadButton" Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" Width="44" Height="44" Margin="0,1,2,1" Focusable="False" Foreground="{StaticResource PosMuted}" ToolTip="Mở bàn phím số" AutomationProperties.Name="Mở bàn phím số" Command="{x:Static touch:TouchInput.OpenCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"><md:PackIcon Kind="Dialpad" Width="20" Height="20"/></Button></Grid></Border><Border x:Name="HintNotch" Background="{TemplateBinding Background}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Padding="4,0" IsHitTestVisible="False"><ContentPresenter x:Name="HintText" Content="{TemplateBinding md:HintAssist.Hint}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource PosMuted}"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="md:HintAssist.Hint" Value="{x:Null}"><Setter TargetName="HintNotch" Property="Visibility" Value="Collapsed"/><Setter TargetName="InputSurface" Property="Margin" Value="0"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="HintText" Property="TextElement.Foreground" Value="{StaticResource PosAccent}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource PosAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource PosDanger}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}"><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="{StaticResource PosSurface}"/><Setter Property="BorderBrush" Value="{StaticResource PosBorderStrong}"/><Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="8"/><Setter Property="md:HintAssist.Background" Value="{StaticResource PosSurface}"/><Setter Property="md:TextFieldAssist.OutlinedBorderActiveThickness" Value="1"/></Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}"><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="{StaticResource PosSurface}"/><Setter Property="BorderBrush" Value="{StaticResource PosBorderStrong}"/><Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="8"/><Setter Property="md:HintAssist.Background" Value="{StaticResource PosSurface}"/><Setter Property="md:TextFieldAssist.OutlinedBorderActiveThickness" Value="1"/><Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly"/></Style>
 <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="12,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}"><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignRadioButton}"><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}"><Setter Property="Background" Value="{StaticResource PosSurface}"/><Setter Property="BorderBrush" Value="{StaticResource PosBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PosBorder}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="RowHeight" Value="52"/><Setter Property="ColumnHeaderHeight" Value="48"/><Setter Property="FontSize" Value="14"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="ScrollViewer.PanningMode" Value="Both"/><Setter Property="EnableRowVirtualization" Value="True"/></Style>
 <Style TargetType="ListBox" BasedOn="{StaticResource MaterialDesignListBox}"><Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
 <Style TargetType="ListView" BasedOn="{StaticResource MaterialDesignListView}"><Setter Property="ScrollViewer.PanningMode" Value="Both"/></Style>
 <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}"><Setter Property="MinHeight" Value="52"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="ScrollViewer" BasedOn="{StaticResource MaterialDesignScrollViewer}"><Setter Property="PanningMode" Value="VerticalOnly"/></Style>
 <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}"><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="12,4"/><Setter Property="Background" Value="{StaticResource PosSurface}"/><Setter Property="BorderBrush" Value="{StaticResource PosBorderStrong}"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="8"/><Setter Property="md:HintAssist.Background" Value="{StaticResource PosSurface}"/><Setter Property="md:TextFieldAssist.OutlinedBorderActiveThickness" Value="1"/></Style>
 <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}"/>
 <Style TargetType="ToolTip" BasedOn="{StaticResource MaterialDesignToolTip}"><Setter Property="FontSize" Value="13"/></Style>
</ResourceDictionary>
