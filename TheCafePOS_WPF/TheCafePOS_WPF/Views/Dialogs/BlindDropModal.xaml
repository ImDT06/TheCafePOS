<Window Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.BlindDropModal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:touch="clr-namespace:TheCafePOS_WPF.Core" Title="Chốt Ca Mù (Blind Drop)" Height="560" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F5F4">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,15">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <TextBlock Text="Chốt ca làm việc" VerticalAlignment="Center" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Text="Nhân viên tự đếm tiền thực tế trong két và nhập vào hệ thống:" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="22">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Tiền đầu ca:" FontWeight="SemiBold" Foreground="#475569" TextWrapping="Wrap" />
          <TextBlock x:Name="TxtInitialCash" Text="0đ" FontSize="15" Foreground="#1E293B" FontWeight="Bold" Margin="0,2,0,15" TextWrapping="Wrap" />
          <TextBlock Text="Nhập tổng tiền mặt đếm được cuối ca (đ):" FontWeight="Bold" Foreground="#12634B" TextWrapping="Wrap" />
          <TextBox x:Name="TxtActualCashInput" touch:TouchInput.Label="Tiền mặt đếm được cuối ca" touch:TouchInput.Numeric="True" FontSize="20" FontWeight="Bold" Padding="8" Margin="0,5,0,15" PreviewTextInput="TxtActualCashInput_PreviewTextInput" />
          <Border x:Name="PnlResult" Visibility="Collapsed" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Padding="10" CornerRadius="5">
            <StackPanel>
              <TextBlock x:Name="TxtExpectedCash" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#92400E" TextWrapping="Wrap" />
              <TextBlock x:Name="TxtDiscrepancy" Text="Chênh lệch: 0đ" FontSize="15" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
      <Button Content="Hủy" Width="90" Height="48" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click" />
      <Button x:Name="BtnConfirmDrop" Width="190" Height="48" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnConfirmDrop_Click" Style="{StaticResource PrimaryButton}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="M 9,16.17 L 4.83,12 L 3.41,13.41 L 9,19 L 21,7 L 19.59,5.59 L 9,16.17 Z" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="Xác nhận chốt ca" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</Window>