<Window x:Class="TheCafePOS_WPF.Views.Dialogs.BlindDropModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:touch="clr-namespace:TheCafePOS_WPF.Core"
        Title="Chốt Ca Mù (Blind Drop)" Height="560" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="M 18,8 L 17,8 L 17,6 C 17,3.24 14.76,1 12,1 C 9.24,1 7,3.24 7,6 L 7,8 L 6,8 C 4.9,8 4,8.9 4,10 L 4,20 C 4,21.1 4.9,22 6,22 L 18,22 C 19.1,22 20,21.1 20,20 L 20,10 C 20,8.9 19.1,8 18,8 Z M 9,6 C 9,4.34 10.34,3 12,3 C 13.66,3 15,4.34 15,6 L 15,8 L 9,8 L 9,6 Z"
                      Fill="#DC2626" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="CHỐT CA MÙ (BLIND DROP)" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Nhân viên tự đếm tiền thực tế trong két và nhập vào hệ thống:" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="15">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Tiền đầu ca:" FontWeight="SemiBold" Foreground="#475569"/>
                <TextBlock x:Name="TxtInitialCash" Text="500.000đ" FontSize="15" Foreground="#1E293B" FontWeight="Bold" Margin="0,2,0,15"/>

                <TextBlock Text="Nhập tổng tiền mặt đếm được cuối ca (đ):" FontWeight="Bold" Foreground="#0284C7"/>
                <TextBox x:Name="TxtActualCashInput" touch:TouchInput.Numeric="True" FontSize="20" FontWeight="Bold" Padding="8" Margin="0,5,0,15" PreviewTextInput="TxtActualCashInput_PreviewTextInput"/>

                <Border x:Name="PnlResult" Visibility="Collapsed" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Padding="10" CornerRadius="5">
                    <StackPanel>
                        <TextBlock x:Name="TxtExpectedCash" Text="Hệ thống tính: 1.250.000đ" FontSize="13" FontWeight="SemiBold" Foreground="#92400E"/>
                        <TextBlock x:Name="TxtDiscrepancy" Text="Chênh lệch: 0đ" FontSize="15" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="90" Height="48" Margin="0,0,10,0" Background="#94A3B8" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button x:Name="BtnConfirmDrop" Width="190" Height="48" Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnConfirmDrop_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 9,16.17 L 4.83,12 L 3.41,13.41 L 9,19 L 21,7 L 19.59,5.59 L 9,16.17 Z"
                          Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="CHỐT CA &amp; NỘP TIỀN" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>



