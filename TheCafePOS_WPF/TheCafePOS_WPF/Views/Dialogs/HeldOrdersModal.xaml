<Window xmlns:touch="clr-namespace:TheCafePOS_WPF.Core" Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.HeldOrdersModal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Đơn đang giữ" Width="680" Height="560" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="24"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Đơn đang giữ" Style="{StaticResource PageTitle}"/><TextBlock Text="Chạm một đơn để tiếp tục bán; chạm nhiều đơn để hủy cùng lúc" Style="{StaticResource Hint}"/></StackPanel>
 <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="BtnDiscard" Content="Hủy đơn giữ" Style="{StaticResource DangerButton}" Click="BtnDiscard_Click"/><Button x:Name="BtnSelectAll" Content="Chọn tất cả" Margin="8,0,0,0" Click="BtnSelectAll_Click"/></StackPanel><Button Grid.Column="1" Content="Đóng" Width="100" Click="BtnCancel_Click"/><Button x:Name="BtnRecall" Grid.Column="3" Content="Tiếp tục đơn này" Style="{StaticResource PrimaryButton}" Click="BtnRecall_Click"/></Grid>
 <Grid><Border Style="{StaticResource SurfaceCard}" Padding="8"><ListBox x:Name="LbHeldOrders" SelectionMode="Multiple" SelectionChanged="LbHeldOrders_SelectionChanged" touch:EmptyState.Text="Chưa có dữ liệu" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding HeldTime, StringFormat='Đơn giữ lúc {0:HH:mm}'}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding HeldTime, StringFormat=dd/MM/yyyy}" Foreground="{StaticResource PosMuted}" Margin="0,4,0,0"/><TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{StaticResource PosMuted}"/></StackPanel><StackPanel Grid.Column="2" Margin="14,0,0,0"><TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0}đ'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PosMoney}"/><TextBlock Text="{Binding Items.Count, StringFormat='{}{0} dòng món'}" HorizontalAlignment="Right" Foreground="{StaticResource PosMuted}" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
 <TextBlock Text="Chưa có đơn đang giữ" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PosMuted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=LbHeldOrders, Path=HasItems}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
 </DockPanel>
</Window>
