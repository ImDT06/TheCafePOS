<Window x:Class="TheCafePOS_WPF.Views.Dialogs.HeldOrdersModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Danh Sách Đơn Đang Tạm Dừng (Hold)" Height="420" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Path Data="M 6,19 L 10,19 L 10,5 L 6,5 L 6,19 Z M 14,5 L 14,19 L 18,19 L 18,5 L 14,5 Z"
                      Fill="#7C3AED" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="ĐƠN HÀNG ĐANG TẠM DỪNG (HOLD ORDERS)" FontSize="18" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Chọn đơn cần khôi phục (Recall) để tiếp tục thanh toán:" FontSize="13" Foreground="#64748B" Margin="24,4,0,0"/>
        </StackPanel>

        <ListBox x:Name="LbHeldOrders" Grid.Row="1" DisplayMemberPath="DisplaySummary" FontSize="14" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="90" Height="48" Margin="0,0,10,0" Background="#94A3B8" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Width="180" Height="48" Background="#7C3AED" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnRecall_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 8,5 L 19,12 L 8,19 L 8,5 Z"
                          Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="KHÔI PHỤC ĐƠN NÀY" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>

