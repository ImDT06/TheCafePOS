<Window xmlns:touch="clr-namespace:TheCafePOS_WPF.Core" Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.HeldOrdersModal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Đơn đang giữ" Width="680" Height="560" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="24"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Đơn đang giữ" Style="{StaticResource PageTitle}"/><TextBlock Text="Chọn đơn để tiếp tục chỉnh món và thanh toán" Style="{StaticResource Hint}"/></StackPanel>
 <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="1" Content="Đóng" Width="100" Click="BtnCancel_Click"/><Button Grid.Column="3" Content="Tiếp tục đơn này" Click="BtnRecall_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding ElementName=LbHeldOrders, Path=SelectedItem}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid>
 <Grid><Border Style="{StaticResource SurfaceCard}" Padding="8"><ListBox x:Name="LbHeldOrders" touch:EmptyState.Text="Chưa có dữ liệu" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding HeldTime, StringFormat='Đơn giữ lúc {0:HH:mm}'}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding HeldTime, StringFormat=dd/MM/yyyy}" Foreground="#52665F" Margin="0,4,0,0"/><TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#52665F"/></StackPanel><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0}đ'}" FontSize="20" FontWeight="Bold" Foreground="#12634B"/><TextBlock Text="{Binding Items.Count, StringFormat='{}{0} dòng món'}" HorizontalAlignment="Right" Foreground="#52665F" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
 <TextBlock Text="Chưa có đơn đang giữ" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#52665F" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=LbHeldOrders, Path=HasItems}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
 </DockPanel>
</Window>
