<Window xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TheCafePOS — Đăng nhập" Width="980" Height="680" MinWidth="820" MinHeight="640" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <!-- Segmented switch between staff PIN and password sign-in. -->
  <Style x:Key="ModeTab" TargetType="RadioButton">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource PosMuted}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Tab" CornerRadius="8" Padding="10" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource PosInk}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Tab" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12"/></Setter.Value></Setter></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource PosAccent}"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>

  <!-- Brand panel -->
  <Border>
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{StaticResource PosAccentColor}" Offset="0"/><GradientStop Color="{StaticResource PosAccentDarkColor}" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid Margin="40,36">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
     <Border Width="46" Height="46" CornerRadius="12" Background="#26FFFFFF"><md:PackIcon Kind="Coffee" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="TheCafePOS" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
     <TextBlock x:Name="Welcome" Text="Chào mừng trở lại" FontSize="34" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
     <TextBlock Text="Bán hàng, pha chế và quản lý ca làm việc trên cùng một màn hình." FontSize="15" Foreground="{StaticResource PosAccentSoft}" Opacity="0.85" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <TextBlock x:Name="ClockTime" FontSize="44" FontWeight="Light" Foreground="White"/>
     <TextBlock x:Name="ClockDate" FontSize="14" Foreground="{StaticResource PosAccentSoft}" Opacity="0.85"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- Sign-in form -->
  <Grid Grid.Column="1" Background="{StaticResource PosSurface}">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="400" Margin="48,36,48,12" VerticalAlignment="Center">
     <TextBlock x:Name="FormTitle" Text="Đăng nhập" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PosInk}"/>
     <TextBlock x:Name="Heading" Text="Đăng nhập để bắt đầu làm việc." Style="{StaticResource Hint}" Margin="0,6,0,22"/>

     <Border x:Name="ModeSwitch" Visibility="Collapsed" Background="{StaticResource PosSubtle}" CornerRadius="10" Padding="4" Margin="0,0,0,22">
      <UniformGrid Columns="2">
       <RadioButton x:Name="ModePin" GroupName="LoginMode" Style="{StaticResource ModeTab}" Checked="ModePin_Checked" AutomationProperties.Name="Nhân viên đăng nhập bằng mã PIN">
        <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Dialpad" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Nhân viên (mã PIN)"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="ModePassword" GroupName="LoginMode" Style="{StaticResource ModeTab}" Checked="ModePassword_Checked" AutomationProperties.Name="Đăng nhập bằng mật khẩu">
        <StackPanel Orientation="Horizontal"><md:PackIcon Kind="LockOutline" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Mật khẩu"/></StackPanel>
       </RadioButton>
      </UniformGrid>
     </Border>

     <!-- Both sign-in forms share one cell and are hidden, not collapsed, so switching modes never moves the tabs or the button. -->
     <Grid x:Name="FormFields" Height="178">
     <!-- PIN: pick your name, then type the PIN. -->
     <Grid x:Name="PinPanel" Visibility="Collapsed" VerticalAlignment="Top">
      <StackPanel x:Name="PinPick" VerticalAlignment="Top">
       <TextBlock Text="Chọn tên của bạn" FontWeight="SemiBold" Foreground="{StaticResource PosInk}" Margin="0,0,0,10"/>
       <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PinAccounts"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Tag="{Binding Username}" Click="PinUser_Click" Margin="0,0,10,10" Cursor="Hand" AutomationProperties.Name="{Binding Username}">
          <Button.Template><ControlTemplate TargetType="Button">
           <Border x:Name="Card" Width="140" Height="56" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource PosBorder}" Background="White" Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
             <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource PosAccentSoft}"><TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PosAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
             <TextBlock Text="{Binding Username}" Margin="10,0,0,0" MaxWidth="72" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{StaticResource PosInk}"/>
            </StackPanel>
           </Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PosAccent}"/><Setter TargetName="Card" Property="Background" Value="{StaticResource PosSubtle}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PosAccent}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
         </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl></ScrollViewer>
      </StackPanel>
      <StackPanel x:Name="PinEntry" Visibility="Hidden" VerticalAlignment="Top">
       <DockPanel Margin="0,0,0,14">
        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource PosAccentSoft}"><TextBlock x:Name="PinInitial" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PosAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <Button DockPanel.Dock="Right" Click="ChangePinUser_Click" Style="{StaticResource MaterialDesignFlatButton}" VerticalAlignment="Center" AutomationProperties.Name="Chọn người khác">
         <StackPanel Orientation="Horizontal"><md:PackIcon Kind="AccountSwitchOutline" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Đổi người"/></StackPanel>
        </Button>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="PinTitle" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PosInk}"/><TextBlock Text="Nhập mã PIN 4–6 số" FontSize="12" Foreground="{StaticResource PosMuted}"/></StackPanel>
       </DockPanel>
       <PasswordBox md:HintAssist.Hint="Mã PIN" x:Name="Pin" AutomationProperties.Name="Mã PIN" MaxLength="6" InputScope="Number" FontSize="22" md:TextFieldAssist.HasLeadingIcon="True" md:TextFieldAssist.LeadingIcon="Dialpad" PasswordChanged="Input_Changed"/>
      </StackPanel>
     </Grid>

     <!-- Username and password. -->
     <StackPanel x:Name="PasswordEntry" VerticalAlignment="Top">
      <TextBox md:HintAssist.Hint="Tên đăng nhập" x:Name="Username" AutomationProperties.Name="Tên đăng nhập" md:TextFieldAssist.HasLeadingIcon="True" md:TextFieldAssist.LeadingIcon="AccountOutline" TextChanged="Input_Changed" Margin="0,0,0,16"/>
      <PasswordBox md:HintAssist.Hint="Mật khẩu" x:Name="Password" AutomationProperties.Name="Mật khẩu" md:TextFieldAssist.HasLeadingIcon="True" md:TextFieldAssist.LeadingIcon="LockOutline" PasswordChanged="Input_Changed" Margin="0,0,0,14"/>
      <StackPanel x:Name="Confirmation" Visibility="Collapsed" Margin="0,10,0,0"><PasswordBox md:HintAssist.Hint="Nhập lại mật khẩu" x:Name="ConfirmPassword" AutomationProperties.Name="Nhập lại mật khẩu" md:TextFieldAssist.HasLeadingIcon="True" md:TextFieldAssist.LeadingIcon="LockCheckOutline" PasswordChanged="Input_Changed"/></StackPanel>
      <DockPanel x:Name="PasswordOptions">
       <Button x:Name="ForgotPassword" DockPanel.Dock="Right" Content="Quên mật khẩu?" Click="ForgotPassword_Click" Style="{StaticResource MaterialDesignFlatButton}" Padding="6,0" VerticalAlignment="Center"/>
       <CheckBox x:Name="RememberLogin" IsChecked="True" VerticalAlignment="Center"><TextBlock Text="Giữ đăng nhập 30 ngày" TextWrapping="Wrap"/></CheckBox>
      </DockPanel>
     </StackPanel>
     </Grid>

     <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{StaticResource PosDangerSoft}" BorderBrush="{StaticResource PosDangerBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
      <DockPanel><md:PackIcon Kind="AlertCircleOutline" Foreground="{StaticResource PosDanger}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top"/><TextBlock x:Name="Error" Foreground="{StaticResource PosDanger}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></DockPanel>
     </Border>

     <Button x:Name="Submit" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Submit_Click" Margin="0,16,0,0" MinHeight="54" md:ButtonAssist.CornerRadius="10">
      <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Login" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="SubmitText" Text="Đăng nhập" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     </Button>
    </StackPanel>
   </ScrollViewer>
   <TextBlock Grid.Row="1" Text="TheCafePOS · Cần hỗ trợ tài khoản? Liên hệ chủ quán." FontSize="12" Foreground="{StaticResource PosMuted}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
  </Grid>
 </Grid>
</Window>
