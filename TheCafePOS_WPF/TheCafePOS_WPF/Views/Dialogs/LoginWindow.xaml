<Window x:Class="TheCafePOS_WPF.Views.Dialogs.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TheCafePOS — Đăng nhập" Width="430" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F1F5F9">
 <StackPanel Margin="28">
  <TextBlock Text="TheCafePOS" FontSize="26" FontWeight="Bold" Foreground="#0284C7"/>
  <TextBlock x:Name="Heading" Text="Đăng nhập để bắt đầu làm việc" Margin="0,12" TextWrapping="Wrap"/>
  <TextBlock Text="Tên đăng nhập"/><TextBox x:Name="Username" Padding="8" Margin="0,5,0,12"/>
  <TextBlock Text="Mật khẩu"/><PasswordBox x:Name="Password" Padding="8" Margin="0,5,0,12"/>
  <StackPanel x:Name="Confirmation" Visibility="Collapsed"><TextBlock Text="Nhập lại mật khẩu"/><PasswordBox x:Name="ConfirmPassword" Padding="8" Margin="0,5,0,12"/></StackPanel>
  <CheckBox x:Name="RememberLogin" Content="Giữ đăng nhập trên máy này (30 ngày)" IsChecked="True" Margin="0,0,0,8"/>
  <TextBlock x:Name="Error" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <Button x:Name="Submit" Content="Đăng nhập" Padding="10" IsDefault="True" Click="Submit_Click"/>
 </StackPanel>
</Window>


