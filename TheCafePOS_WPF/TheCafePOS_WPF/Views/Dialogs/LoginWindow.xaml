<Window Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TheCafePOS — Đăng nhập" Width="500" Height="650" MinWidth="440" MinHeight="480" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="28">
  <Border DockPanel.Dock="Top" Background="#123D35" CornerRadius="14" Padding="22" Margin="0,0,0,18"><StackPanel><TextBlock Text="TheCafePOS" FontSize="30" FontWeight="Bold" Foreground="White"/><TextBlock x:Name="Heading" Text="Đăng nhập để bắt đầu làm việc" Foreground="#D0ECE1" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  <Button DockPanel.Dock="Bottom" x:Name="Submit" Style="{StaticResource PrimaryButton}" Content="Đăng nhập" IsDefault="True" Click="Submit_Click" Margin="0,18,0,0"/>
  <Border Style="{StaticResource SurfaceCard}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Tài khoản của bạn" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="Tên đăng nhập"/><TextBox x:Name="Username" AutomationProperties.Name="Tên đăng nhập" Margin="0,6,0,16"/>
   <TextBlock Text="Mật khẩu"/><PasswordBox x:Name="Password" AutomationProperties.Name="Mật khẩu" Margin="0,6,0,16"/>
   <StackPanel x:Name="Confirmation" Visibility="Collapsed"><TextBlock Text="Nhập lại mật khẩu"/><PasswordBox x:Name="ConfirmPassword" Margin="0,6,0,16"/></StackPanel>
   <CheckBox x:Name="RememberLogin" IsChecked="True" Margin="0,0,0,8"><TextBlock Text="Giữ đăng nhập trên máy này (30 ngày)" TextWrapping="Wrap"/></CheckBox>
   <TextBlock x:Name="Error" Foreground="#B42318" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer></Border>
 </DockPanel>
</Window>
