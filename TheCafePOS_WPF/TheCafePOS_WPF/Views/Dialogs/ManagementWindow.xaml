<Window xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.ManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:touch="clr-namespace:TheCafePOS_WPF.Core" Title="Quản trị cửa hàng" Width="1120" Height="760" MinWidth="920" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{StaticResource PosCanvas}">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Quản trị cửa hàng" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Thực đơn, nhân viên và thông tin nhận tiền" Style="{StaticResource Hint}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,0" />
    <TabControl>
      <TabItem Header="Thực đơn">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
          </Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,15,0">
            <StackPanel DockPanel.Dock="Top">
              <TextBox md:HintAssist.Hint="Tìm món trong thực đơn" x:Name="MenuSearch" TextChanged="MenuSearch_TextChanged" AutomationProperties.Name="Tìm tên món trong quản trị" ToolTip="Tìm tên món" Margin="0,0,0,10" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="+ Thêm món mới" Padding="8" Margin="0,10,0,0" Click="NewProduct_Click" />
            <DataGrid x:Name="Products" touch:EmptyState.Text="Không có món phù hợp — bấm &quot;+ Thêm món mới&quot;" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="ProductSelected">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Tên món" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Giá mặc định" Binding="{Binding FormattedPrice}" Width="125" />
                <DataGridCheckBoxColumn Header="Đang bán" Binding="{Binding IsActive}" ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}" EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
                  <DataGridCheckBoxColumn Header="Hết hàng" Binding="{Binding IsSoldOut}" ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}" EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
          <Border Grid.Column="1" Style="{StaticResource SurfaceCard}">
            <DockPanel>
              <Button Style="{StaticResource PrimaryButton}" Content="Lưu món" Padding="8" Click="SaveProduct_Click" DockPanel.Dock="Bottom" Margin="0,14,0,0" />
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Thông tin món" Style="{StaticResource SectionTitle}" />
                  <Border Height="130" CornerRadius="8" Background="{StaticResource PosBorder}" Margin="0,4,0,8"><Grid><TextBlock x:Name="ProductImageHint" Text="Chưa có ảnh" Foreground="{StaticResource PosMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="ProductImage" Stretch="Uniform" Margin="6" /></Grid></Border>
                  <UniformGrid Columns="2" Margin="0,0,0,10"><Button Content="Chọn ảnh…" Padding="8" Margin="0,0,4,0" Click="PickImage_Click" /><Button Content="Gỡ ảnh" Padding="8" Margin="4,0,0,0" Click="RemoveImage_Click" /></UniformGrid>
                  <TextBlock Text="Chọn một món để sửa hoặc thêm món mới." Style="{StaticResource Hint}" />
                  <TextBox md:HintAssist.Hint="Tên món" x:Name="ProductName" Margin="0,4,0,10" />
                  <ComboBox md:HintAssist.Hint="Danh mục" x:Name="ProductCategory" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,10" />
                  <TextBox md:HintAssist.Hint="Giá cơ bản (đồng)" x:Name="ProductPrice" touch:TouchInput.Label="Giá cơ bản của món" touch:TouchInput.Numeric="True" Margin="0,4,0,10" />
                  <CheckBox x:Name="ProductActive" Content="Đang bán (bỏ chọn để ẩn khỏi thực đơn)" IsChecked="True" Margin="0,4,0,6" />
                  <CheckBox x:Name="ProductSoldOut" Content="Hết hàng tạm thời (vẫn hiện, làm mờ)" Margin="0,4,0,10" />
                  <Button Content="Cấu hình size / topping / đường đá" Padding="8" Margin="0,8,0,0" Click="ConfigureProduct_Click" />
                  <Button Content="Công thức (định lượng nguyên liệu)…" Padding="8" Margin="0,8,0,0" Click="Recipe_Click" />
                  <Button Content="Xóa món" Style="{StaticResource DangerButton}" Padding="8" Margin="0,24,0,0" Click="DeleteProduct_Click" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Danh mục">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
          </Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,15,0"><Button DockPanel.Dock="Bottom" Content="+ Thêm danh mục mới" Padding="8" Margin="0,10,0,0" Click="NewCategory_Click" /><ListBox x:Name="Categories" touch:EmptyState.Text="Chưa có danh mục" DisplayMemberPath="Name" SelectionChanged="CategorySelected" /></DockPanel>
          <Border Grid.Column="1" Style="{StaticResource SurfaceCard}">
            <DockPanel>
              <Button Style="{StaticResource PrimaryButton}" Content="Lưu danh mục" Padding="8" Click="SaveCategory_Click" DockPanel.Dock="Bottom" Margin="0,14,0,0" />
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Nhóm thực đơn" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="Sắp nhóm giúp thu ngân tìm món nhanh hơn." Style="{StaticResource Hint}" />
                  <TextBox md:HintAssist.Hint="Tên danh mục" x:Name="CategoryName" Margin="0,4,0,10" />
                  <CheckBox x:Name="CategoryActive" Content="Đang hiển thị" IsChecked="True" Margin="0,4,0,10" />
                  <Button Content="Xóa danh mục" Style="{StaticResource DangerButton}" Padding="8" Margin="0,24,0,0" Click="DeleteCategory_Click" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Nhân viên">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
          </Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,15,0"><Button DockPanel.Dock="Bottom" Content="+ Thêm nhân viên mới" Padding="8" Margin="0,10,0,0" Click="NewStaff_Click" />
          <DataGrid x:Name="Staff" touch:EmptyState.Text="Chưa có nhân viên" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="StaffSelected">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="*" />
              <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="100" />
              <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}" EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
              <DataGridCheckBoxColumn Header="Đổi mật khẩu" Binding="{Binding MustChangePassword}" ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}" EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
            </DataGrid.Columns>
          </DataGrid>
          </DockPanel>
          <Border Grid.Column="1" Style="{StaticResource SurfaceCard}">
            <DockPanel>
              <Button Style="{StaticResource PrimaryButton}" x:Name="SaveStaff" Content="Tạo tài khoản" Padding="8" Click="CreateStaff_Click" DockPanel.Dock="Bottom" Margin="0,14,0,0" />
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Quản lý nhân viên" FontWeight="Bold" Margin="0,0,0,12" />
                  <TextBox md:HintAssist.Hint="Tên đăng nhập" x:Name="StaffName" Margin="0,4,0,10" />
                  <PasswordBox md:HintAssist.Hint="Mật khẩu mới (bỏ trống nếu không đổi)" x:Name="StaffPassword" Margin="0,4,0,10" />
                  <ComboBox md:HintAssist.Hint="Vai trò" x:Name="StaffRole" SelectedIndex="0" Margin="0,4,0,10">
                    <ComboBoxItem Content="Cashier" />
                    <ComboBoxItem Content="Manager" />
                  </ComboBox>
                  <TextBlock Text="Các thao tác nhanh (dành cho tài khoản đang chọn):" TextWrapping="Wrap" Margin="0,16,0,8" />
                  <Button Content="Đặt lại mật khẩu tạm thời" Padding="8" Click="ResetPassword_Click" />
                  <Button Content="Khóa / Mở khóa tài khoản" Padding="8" Margin="0,8,0,0" Click="ToggleStaff_Click" />
                  <Button Content="Xóa tài khoản" Style="{StaticResource DangerButton}" Padding="8" Margin="0,24,0,0" Click="DeleteStaff_Click" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Chuyển khoản">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource SurfaceCard}" Margin="12" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Text="Thông tin tài khoản nhận tiền" FontWeight="Bold" FontSize="16" />
              <TextBox Margin="0,8,0,8" md:HintAssist.Hint="Mã ngân hàng (ví dụ MB)" x:Name="BankCode" />
              <TextBox Margin="0,8,0,8" md:HintAssist.Hint="Số tài khoản" x:Name="BankAccount" />
              <TextBox Margin="0,8,0,8" md:HintAssist.Hint="Tên chủ tài khoản" x:Name="BankOwner" />
              <PasswordBox Margin="0,8,0,8" md:HintAssist.Hint="API Token SePay (không bắt buộc)" x:Name="SePayToken" ToolTip="my.sepay.vn → Cấu hình công ty → API Access → Thêm API" />
<TextBlock Text="Có token: màn QR tự xác nhận khi tiền vào đúng nội dung và số tiền. Không có token hoặc mất mạng: quản lý kiểm tra giao dịch thực tế rồi duyệt thủ công." TextWrapping="Wrap" Foreground="{StaticResource PosMuted}" Margin="0,8,0,16" />
              <Button Style="{StaticResource PrimaryButton}" Content="Lưu thông tin chuyển khoản" Padding="8" Click="SaveBank_Click" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Cửa hàng &amp; Sao lưu">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource SurfaceCard}" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="Cửa hàng &amp; bán hàng" FontWeight="Bold" />
              <TextBlock Text="Thông tin quán, hạn mức giảm giá của thu ngân và các kênh app giao hàng." Style="{StaticResource Hint}" />
              <Button Style="{StaticResource PrimaryButton}" Content="Cài đặt cửa hàng…" Padding="8" Click="OpenStoreSettings_Click" />
              <TextBlock Text="Khuyến mãi" FontWeight="Bold" Margin="0,24,0,0" />
              <TextBlock Text="Giờ vàng giảm %, mua X tặng Y, combo giá cố định. Các chương trình đang bật được cộng dồn tự động." Style="{StaticResource Hint}" />
              <Button Content="Chương trình khuyến mãi…" Padding="8" Click="OpenPromotions_Click" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Text="Sao lưu dữ liệu" FontWeight="Bold" />
              <TextBlock Text="App tự sao lưu mỗi ngày và sau mỗi lần chốt ca, giữ 14 bản gần nhất trên máy và đưa từng bản lên Supabase để máy hỏng không mất dữ liệu." Style="{StaticResource Hint}" />
              <TextBlock x:Name="BackupInfo" Margin="0,0,0,4" TextWrapping="Wrap" />
              <TextBlock x:Name="CloudInfo" Margin="0,0,0,12" TextWrapping="Wrap" />
              <Button x:Name="BackupNowButton" Style="{StaticResource PrimaryButton}" Content="Sao lưu ngay" Padding="8" Click="BackupNow_Click" />
              <Button Content="Mở thư mục sao lưu" Padding="8" Margin="0,8,0,0" Click="OpenBackups_Click" />
              <Button Content="Khôi phục từ bản sao lưu…" Style="{StaticResource DangerButton}" Padding="8" Margin="0,8,0,0" Click="RestoreBackup_Click" />
              <TextBlock Text="Khách hàng thành viên" FontWeight="Bold" Margin="0,24,0,0" />
              <TextBlock x:Name="MemberInfo" Style="{StaticResource Hint}" />
              <Button Content="Quản lý khách hàng…" Padding="8" Click="OpenCustomers_Click" />
              <TextBlock Text="Kho nguyên liệu" FontWeight="Bold" Margin="0,24,0,8" />
              <Button Content="Mở kho nguyên liệu…" Padding="8" Click="OpenIngredients_Click" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
