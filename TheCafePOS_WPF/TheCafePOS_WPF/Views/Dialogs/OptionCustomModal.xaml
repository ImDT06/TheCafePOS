<Window Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.OptionCustomModal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Tùy chỉnh món" Width="1040" Height="700" MinWidth="960" MinHeight="640"
 WindowStartupLocation="CenterOwner" Background="#F3F5F4" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style x:Key="Choice" TargetType="RadioButton">
   <Setter Property="MinHeight" Value="48"/><Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="Padding" Value="6,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#334155"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Surface" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EFF7F2"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E8F2ED"/><Setter TargetName="Surface" Property="BorderBrush" Value="#12634B"/><Setter Property="Foreground" Value="#123D35"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#0F172A"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="MinHeight" Value="48"/><Setter Property="MinWidth" Value="48"/><Setter Property="Padding" Value="10,6"/>
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#0F172A"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#0F172A"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="ContextLabel" Foreground="#64748B" FontSize="11"/>
     <TextBlock x:Name="Heading" FontSize="22" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,3,0,0"/>
     <TextBlock x:Name="ChangeNotice" Foreground="#B45309" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,3,0,0"/>
    </StackPanel>
    <TextBlock x:Name="PriceNotice" Grid.Column="1" MaxWidth="220" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="18,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ToppingColumn" Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel x:Name="DrinkOptions" Margin="0,0,14,0">
    <Grid Margin="0,0,0,10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="Kích cỡ" Style="{StaticResource Section}" VerticalAlignment="Center"/>
     <UniformGrid x:Name="SizeChoices" Grid.Column="1" Rows="1"/>
    </Grid>
    <Grid x:Name="SugarPanel" Margin="0,0,0,10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="Đường" Style="{StaticResource Section}" VerticalAlignment="Center"/>
     <UniformGrid x:Name="SugarChoices" Grid.Column="1" Rows="1"/>
    </Grid>
    <Grid x:Name="IcePanel">
     <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="Đá" Style="{StaticResource Section}" VerticalAlignment="Center"/>
     <UniformGrid x:Name="IceChoices" Grid.Column="1" Rows="1"/>
    </Grid>
   </StackPanel>
   <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="80"/></Grid.RowDefinitions>
    <TextBlock Text="Ghi chú cho món · không bắt buộc · tối đa 300 ký tự" Style="{StaticResource Section}"/>
    <TextBox x:Name="Note" TextChanged="Note_TextChanged" Grid.Row="1" Padding="12" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="#CBD5E1" ToolTip="Ví dụ: để topping riêng"/>
   </Grid>
   <Grid x:Name="ToppingSection" Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,6"><TextBlock Text="Topping" Style="{StaticResource Section}"/><TextBlock x:Name="ToppingSummary" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" Text="Số phần / ly"/></DockPanel>
    <UniformGrid x:Name="ToppingRows" Grid.Row="1" Columns="2" Rows="3" SizeChanged="ToppingArea_SizeChanged"/>
    <Grid x:Name="ToppingPager" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="PreviousToppings" Content="‹ Trước" Style="{StaticResource Action}" Click="PreviousToppings_Click"/>
     <TextBlock x:Name="ToppingPageText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0"/>
     <Button x:Name="NextToppings" Grid.Column="2" Content="Tiếp ›" Style="{StaticResource Action}" Click="NextToppings_Click"/>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,12">
   <StackPanel>
    <TextBlock x:Name="Error" Foreground="#DC2626" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="QuantityLabel" Text="Số ly" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
      <StackPanel Orientation="Horizontal"><Button x:Name="MinusQuantity" Content="−" FontSize="22" Style="{StaticResource Action}" Click="MinusQuantity_Click" ToolTip="Giảm số lượng"/>
       <TextBlock x:Name="QuantityText" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
       <Button x:Name="PlusQuantity" Content="+" FontSize="22" Style="{StaticResource Action}" Click="PlusQuantity_Click" ToolTip="Tăng số lượng"/>
      </StackPanel>
      <TextBlock x:Name="QuantityHint" Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,18,0"><TextBlock x:Name="Breakdown" Foreground="#64748B" FontSize="12" HorizontalAlignment="Right"/><TextBlock x:Name="Total" FontSize="26" FontWeight="Bold" Foreground="#12634B" HorizontalAlignment="Right"/></StackPanel>
     <Button Grid.Column="2" Content="Hủy" Width="70" VerticalAlignment="Center" Style="{StaticResource Action}" IsCancel="True"/>
     <Button x:Name="ConfirmButton" Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource Action}" Background="#12634B" Foreground="White" BorderBrush="#12634B" FontWeight="Bold" FontSize="15" MinHeight="54" Click="Confirm_Click"/>
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>



