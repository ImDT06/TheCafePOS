<Window xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.OptionCustomModal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Tùy chỉnh món" Width="1040" Height="700" MinWidth="960" MinHeight="640"
 WindowStartupLocation="CenterOwner" Background="{StaticResource PosCanvas}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style x:Key="Choice" TargetType="RadioButton">
   <Setter Property="MinHeight" Value="48"/><Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="Padding" Value="6,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource PosInk}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Surface" Background="White" BorderBrush="{StaticResource PosBorderStrong}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource PosAccentSoft}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource PosAccentSoft}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosAccent}"/><Setter Property="Foreground" Value="{StaticResource PosAccentDark}"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosInk}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="MinHeight" Value="48"/><Setter Property="MinWidth" Value="48"/><Setter Property="Padding" Value="10,6"/>
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource PosInk}"/><Setter Property="BorderBrush" Value="{StaticResource PosBorderStrong}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosInk}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Whole card is the +1 target; the separate minus only appears once the topping is chosen. -->
  <Style x:Key="ToppingCard" TargetType="Button">
   <Setter Property="MinHeight" Value="52"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosAccent}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosInk}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NoteChip" TargetType="ToggleButton">
   <Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Padding" Value="12,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource PosInk}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Surface" Background="White" BorderBrush="{StaticResource PosBorderStrong}" BorderThickness="1" CornerRadius="20" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource PosAccent}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosAccent}"/><Setter Property="Foreground" Value="White"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosInk}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource PosInk}"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,0,1" Padding="16,8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <DockPanel><Border x:Name="PhotoFrame" DockPanel.Dock="Left" Width="60" Height="60" CornerRadius="10" Background="{StaticResource PosSubtle}" Margin="0,0,16,0" Visibility="Collapsed"><Image x:Name="ProductPhoto" Stretch="Uniform" Margin="4"/></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ContextLabel" Foreground="{StaticResource PosMuted}" FontSize="11"/>
     <TextBlock x:Name="Heading" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PosInk}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,3,0,0"/>
     <TextBlock x:Name="ChangeNotice" Foreground="{StaticResource PosWarning}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,3,0,0"/>
    </StackPanel></DockPanel>
    <TextBlock x:Name="PriceNotice" Grid.Column="1" MaxWidth="220" TextWrapping="Wrap" Foreground="{StaticResource PosMuted}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
   </Grid>
  </Border>
  <!-- Left: drink options, then notes filling the space under them. Right: toppings use the full height. -->
  <Grid Grid.Row="1" Margin="16,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition x:Name="ToppingColumn" Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel x:Name="DrinkOptions" Margin="0,0,14,0">
    <Grid Margin="0,0,0,10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="Kích cỡ" Style="{StaticResource Section}" VerticalAlignment="Center"/>
     <UniformGrid x:Name="SizeChoices" Grid.Column="1" Rows="1"/>
    </Grid>
    <Grid x:Name="SugarPanel" Margin="0,0,0,10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="Đường" Style="{StaticResource Section}" VerticalAlignment="Center"/>
     <UniformGrid x:Name="SugarChoices" Grid.Column="1" Rows="1"/>
    </Grid>
    <Grid x:Name="IcePanel">
     <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="Đá" Style="{StaticResource Section}" VerticalAlignment="Center"/>
     <UniformGrid x:Name="IceChoices" Grid.Column="1" Rows="1"/>
    </Grid>
   </StackPanel>
   <StackPanel Grid.Row="1" Margin="0,14,14,0">
    <TextBlock Text="Ghi chú" Style="{StaticResource Section}"/>
    <!-- Common requests are one tap; the free-text box stays for anything else. -->
    <WrapPanel x:Name="QuickNotes"/>
    <TextBox Margin="0,12,6,0" md:HintAssist.Hint="Ghi chú khác (không bắt buộc)" x:Name="Note" TextChanged="Note_TextChanged" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="96" MaxHeight="140" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderBrush="{StaticResource PosBorderStrong}" ToolTip="Ví dụ: ghi tên khách lên ly"/>
   </StackPanel>
   <Grid x:Name="ToppingSection" Grid.Column="1" Grid.RowSpan="3">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,6"><TextBlock Text="Topping" Style="{StaticResource Section}"/><TextBlock x:Name="ToppingSummary" FontSize="12" Foreground="{StaticResource PosMuted}" HorizontalAlignment="Right" Text="Số phần / ly"/></DockPanel>
    <ScrollViewer x:Name="ToppingScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
     <UniformGrid x:Name="ToppingRows" Columns="2" VerticalAlignment="Top"/>
    </ScrollViewer>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource PosBorder}" BorderThickness="0,1,0,0" Padding="16,8">
   <StackPanel>
    <TextBlock x:Name="Error" Foreground="{StaticResource PosDanger}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6"/>
    <!-- Finishing actions sit together on the right: quantity is the last choice before confirming. Cancel stays apart on the left. -->
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><Button Content="Hủy (Esc)" MinWidth="96" Style="{StaticResource Action}" IsCancel="True"/>
      <TextBlock x:Name="KeyHint" Text="Phím 1–9: số ly · Enter: thêm" Foreground="{StaticResource PosMuted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,18,0"><TextBlock x:Name="Breakdown" Foreground="{StaticResource PosMuted}" FontSize="12" HorizontalAlignment="Right"/><TextBlock x:Name="Total" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PosMoney}" HorizontalAlignment="Right"/></StackPanel>
     <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock x:Name="QuantityLabel" Text="Số ly" Foreground="{StaticResource PosMuted}" FontSize="12" Margin="0,0,0,4"/>
      <StackPanel Orientation="Horizontal"><Button x:Name="MinusQuantity" Content="−" FontSize="22" Style="{StaticResource Action}" Click="MinusQuantity_Click" ToolTip="Giảm số lượng (phím −)"/>
       <TextBlock x:Name="QuantityText" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
       <Button x:Name="PlusQuantity" Content="+" FontSize="22" Style="{StaticResource Action}" Click="PlusQuantity_Click" ToolTip="Tăng số lượng (phím +)"/>
      </StackPanel>
      <TextBlock x:Name="QuantityHint" Foreground="{StaticResource PosMuted}" FontSize="11" Margin="0,3,0,0"/>
     </StackPanel>
     <Button x:Name="ConfirmButton" Grid.Column="4" IsDefault="True" VerticalAlignment="Center" Style="{StaticResource Action}" Background="{StaticResource PosAccent}" Foreground="White" BorderBrush="{StaticResource PosAccent}" FontWeight="Bold" FontSize="15" MinHeight="54" Click="Confirm_Click"/>
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>
