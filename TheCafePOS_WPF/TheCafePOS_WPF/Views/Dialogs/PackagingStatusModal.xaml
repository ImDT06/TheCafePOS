<Window Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.PackagingStatusModal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:touch="clr-namespace:TheCafePOS_WPF.Core" Title="Kho bao bì" Width="1120" Height="740" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner">
<DockPanel Margin="20">
 <StackPanel DockPanel.Dock="Top"><TextBlock Text="Kho bao bì" Style="{StaticResource PageTitle}"/><TextBlock x:Name="Summary" Style="{StaticResource Hint}"/></StackPanel>
 <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Đóng" Width="110" Click="BtnClose_Click"/><TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
 <TabControl><TabItem Header="Tồn kho &amp; Cập nhật"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
 <DockPanel Margin="0,0,16,0"><TextBlock DockPanel.Dock="Top" Text="Chọn bao bì để nhập kho hoặc kiểm kê. Dòng vàng cần bổ sung tồn." Style="{StaticResource Hint}"/><DataGrid x:Name="DgPackaging" touch:EmptyState.Text="Chưa có bao bì" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="PackagingSelected">
    <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Style.Triggers><DataTrigger Binding="{Binding IsLowStock}" Value="True"><Setter Property="Background" Value="#FEF3C7"/><Setter Property="Foreground" Value="#92400E"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
    <DataGrid.Columns>
     <DataGridTextColumn Header="Bao bì" Binding="{Binding Name}" Width="*"/>
     <DataGridTextColumn Header="Tồn hệ thống" Binding="{Binding StockQuantity}" Width="130"/>
     <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="90"/>
     <DataGridTextColumn Header="Ngưỡng cảnh báo" Binding="{Binding WarningThreshold}" Width="140"/>
    </DataGrid.Columns>
   </DataGrid></DockPanel>
 <Border Grid.Column="1" Style="{StaticResource SurfaceCard}"><DockPanel>
 <StackPanel DockPanel.Dock="Top"><TextBlock Text="Cập nhật tồn kho" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="PermissionNote" Text="Chọn bao bì cần cập nhật." Style="{StaticResource Hint}"/></StackPanel>
 <DockPanel x:Name="Editor"><Button DockPanel.Dock="Bottom" Content="Lưu thay đổi kho" Style="{StaticResource PrimaryButton}" Click="SaveStock_Click" Margin="0,16,0,0"/>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
 <TextBlock Text="Loại thao tác"/><ComboBox x:Name="Operation" SelectedIndex="0" SelectionChanged="PreviewChanged" Margin="0,6,0,14"><ComboBoxItem Content="Nhập kho"/><ComboBoxItem Content="Kiểm kê"/><ComboBoxItem Content="Điều chỉnh"/></ComboBox>
 <TextBlock Text="Số lượng"/><TextBox x:Name="Quantity" touch:TouchInput.Label="Số lượng bao bì" touch:TouchInput.Unit="đơn vị" touch:TouchInput.Maximum="2147483647" touch:TouchInput.AllowNegative="True" touch:TouchInput.Numeric="True" TextChanged="PreviewChanged" Margin="0,6,0,12" FontSize="22"/>
 <Border Background="#EAF3ED" Padding="12" CornerRadius="8"><TextBlock x:Name="Preview" TextWrapping="Wrap" FontWeight="SemiBold"/></Border>
 <TextBlock Text="Nhập kho: số nhập thêm. Kiểm kê: tổng đếm thực tế. Điều chỉnh: số tăng hoặc giảm." Style="{StaticResource Hint}"/>
 <TextBlock Text="Lý do / nhà cung cấp / số phiếu" TextWrapping="Wrap"/><TextBox x:Name="Reason" MinHeight="80" TextWrapping="Wrap" MaxLength="300" Margin="0,6,0,0"/>
 </StackPanel></ScrollViewer></DockPanel>
 </DockPanel></Border></Grid></TabItem>
 <TabItem Header="Lịch sử biến động"><DockPanel Margin="0,12,0,0"><CheckBox DockPanel.Dock="Top" x:Name="OnlySelected" Content="Chỉ xem bao bì đang chọn" Checked="HistoryFilterChanged" Unchecked="HistoryFilterChanged" Margin="0,0,0,12"/><DataGrid x:Name="History" touch:EmptyState.Text="Chưa có dữ liệu" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns>
     <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="155"/>
     <DataGridTextColumn Header="Bao bì" Binding="{Binding PackagingName}" Width="160"/>
     <DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="90"/>
     <DataGridTextColumn Header="Trước" Binding="{Binding Before}" Width="60"/>
     <DataGridTextColumn Header="Thay đổi" Binding="{Binding Change}" Width="65"/>
     <DataGridTextColumn Header="Sau" Binding="{Binding After}" Width="60"/>
     <DataGridTextColumn Header="Nhân viên" Binding="{Binding Operator}" Width="100"/>
     <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*"/>
    </DataGrid.Columns></DataGrid></DockPanel></TabItem> <TabItem Header="Danh mục bao bì" x:Name="ManageTab">
  <Grid Margin="0,12,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="360"/>
   </Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,16,0">
    <Button DockPanel.Dock="Bottom" Content="+ Thêm bao bì mới" Padding="8" Margin="0,10,0,0" Click="NewPack_Click" />
    <ListBox x:Name="PackList" touch:EmptyState.Text="Chưa có bao bì" DisplayMemberPath="Name" SelectionChanged="PackList_SelectionChanged" />
   </DockPanel>
   <Border Grid.Column="1" Style="{StaticResource SurfaceCard}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="Thông tin bao bì" Style="{StaticResource SectionTitle}"/></StackPanel>
     <Button DockPanel.Dock="Bottom" x:Name="SavePack" Content="Thêm bao bì" Style="{StaticResource PrimaryButton}" Click="SavePack_Click" Margin="0,16,0,0"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="Tên bao bì" Margin="0,6,0,4"/>
       <TextBox x:Name="PackName" Margin="0,0,0,10" Padding="6"/>
       <TextBlock Text="Đơn vị tính" Margin="0,0,0,4"/>
       <TextBox x:Name="PackUnit" Margin="0,0,0,10" Padding="6"/>
       <TextBlock Text="Ngưỡng cảnh báo hết hàng" Margin="0,0,0,4"/>
       <TextBox x:Name="PackWarning" touch:TouchInput.Numeric="True" Padding="6" Margin="0,0,0,10"/>
       <Button Content="Xóa bao bì" Style="{StaticResource DangerButton}" Padding="8" Margin="0,24,0,0" Click="DeletePack_Click" />
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </TabItem>
</TabControl>
</DockPanel></Window>

