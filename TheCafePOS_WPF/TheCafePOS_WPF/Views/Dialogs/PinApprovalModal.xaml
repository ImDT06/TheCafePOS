<Window x:Class="TheCafePOS_WPF.Views.Dialogs.PinApprovalModal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Quản lý phê duyệt" Width="580" Height="600" WindowStartupLocation="CenterOwner" Background="#F8FAFC">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="QUẢN LÝ PHÊ DUYỆT" FontSize="22" FontWeight="Bold" Foreground="#B91C1C" Margin="0,0,0,16"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"><TextBlock x:Name="TxtActionTitle" TextWrapping="Wrap" Foreground="#9A3412" FontSize="14"/></Border>
   <TextBlock Text="Tài khoản quản lý"/><TextBox x:Name="TxtUsername" Margin="0,6,0,14"/>
   <TextBlock Text="Mật khẩu quản lý"/><PasswordBox x:Name="TxtPin" FontSize="20" Margin="0,6,0,12" KeyDown="TxtPin_KeyDown"/>
  </StackPanel></ScrollViewer>
  <UniformGrid Grid.Row="2" Columns="2" Margin="0,16,0,0"><Button Content="Hủy" Margin="0,0,8,0" Click="BtnCancel_Click"/><Button Content="Phê duyệt" Background="#DC2626" Foreground="White" FontWeight="Bold" MinHeight="54" Click="BtnConfirm_Click"/></UniformGrid>
 </Grid>
</Window>
