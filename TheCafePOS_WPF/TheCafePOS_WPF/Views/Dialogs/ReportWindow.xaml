<Window x:Class="TheCafePOS_WPF.Views.Dialogs.ReportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Báo cáo doanh thu" Width="1040" Height="680" WindowStartupLocation="CenterOwner" Background="#F1F5F9">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="BÁO CÁO DOANH THU" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
   <WrapPanel><TextBlock Text="Từ " VerticalAlignment="Center"/><DatePicker x:Name="From" Width="135"/><TextBlock Text=" đến " VerticalAlignment="Center"/><DatePicker x:Name="To" Width="135"/>
    <ComboBox x:Name="ShiftFilter" Width="230" Margin="12,0" DisplayMemberPath="Label" SelectedValuePath="Id"/>
    <Button Content="Xem báo cáo" Padding="10,5" Click="Refresh_Click"/><Button Content="Xuất CSV" Padding="10,5" Margin="10,0" Click="Export_Click"/>
   </WrapPanel>
   <TextBlock x:Name="Summary" FontSize="16" FontWeight="SemiBold" Margin="0,16" TextWrapping="Wrap"/>
  </StackPanel>
  <TabControl>
   <TabItem Header="Đơn hàng"><Grid><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DataGrid x:Name="Orders" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="OrderSelected"><DataGrid.Columns>
     <DataGridTextColumn Header="STT" Binding="{Binding DailyOrderNumberFormatted}"/><DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/>
     <DataGridTextColumn Header="Phương thức" Binding="{Binding PaymentMethod}"/><DataGridTextColumn Header="Tổng tiền" Binding="{Binding FormattedTotal}" Width="120"/><DataGridTextColumn Header="Mã đơn" Binding="{Binding Id}" Width="*"/>
    </DataGrid.Columns></DataGrid>
    <DataGrid x:Name="Items" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Món" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Tùy chọn" Binding="{Binding OptionsSummary}" Width="*"/><DataGridTextColumn Header="SL" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Thành tiền" Binding="{Binding FormattedTotalPrice}"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Header="Món bán (trước hoàn tiền)"><DataGrid x:Name="TopProducts" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Món" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="120"/><DataGridTextColumn Header="Doanh thu" Binding="{Binding Revenue, StringFormat=N0}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Ca đã đóng"><DataGrid x:Name="Shifts" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Nhân viên" Binding="{Binding CashierName}" Width="*"/><DataGridTextColumn Header="Mở ca" Binding="{Binding StartTime, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Đóng ca" Binding="{Binding EndTime, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Dự kiến" Binding="{Binding ExpectedCash, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="Thực tế" Binding="{Binding ActualCash, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="Chênh lệch" Binding="{Binding Discrepancy, StringFormat=N0}" Width="110"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="Hoàn tiền"><DataGrid x:Name="Refunds" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
    <DataGridTextColumn Header="Ngày hoàn" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="155"/><DataGridTextColumn Header="Tiền hoàn" Binding="{Binding Amount, StringFormat=N0}"/><DataGridTextColumn Header="Phương thức" Binding="{Binding Method}"/><DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="Người duyệt" Binding="{Binding Approver}"/><DataGridTextColumn Header="Mã giao dịch" Binding="{Binding Reference}" Width="140"/>
   </DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Thu/chi tiền mặt"><DataGrid x:Name="CashEntries" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
    <DataGridTextColumn Header="Ngày" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="155"/><DataGridTextColumn Header="Loại" Binding="{Binding TypeLabel}"/><DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}"/><DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="Nhân viên" Binding="{Binding Operator}"/><DataGridTextColumn Header="Người duyệt" Binding="{Binding Approver}"/>
   </DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
 </DockPanel>
</Window>


