<Window Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.ReportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Language="vi-VN" Title="Báo cáo kinh doanh" Width="1180" Height="780" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F3F5F4">
 <Window.Resources>
 <Style x:Key="Metric" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,10,12"/></Style>
 <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#12634B"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
</Window.Resources>
<DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Báo cáo kinh doanh" FontSize="26" FontWeight="Bold" Foreground="#123D35"/>
<TextBlock Text="Theo dõi bán hàng, hoàn tiền và đối soát ca" Foreground="#52665F" Margin="0,4,0,12"/>
<WrapPanel Margin="0,0,0,10"><Button Content="Hôm nay" Tag="today" Click="QuickRange_Click" Margin="0,0,8,0"/><Button Content="7 ngày qua" Tag="week" Click="QuickRange_Click" Margin="0,0,8,0"/><Button Content="Tháng này" Tag="month" Click="QuickRange_Click"/><TextBlock x:Name="AppliedRange" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#52665F"/></WrapPanel>
   <WrapPanel><TextBlock Text="Từ " VerticalAlignment="Center"/><DatePicker x:Name="From" Width="135"/><TextBlock Text=" đến " VerticalAlignment="Center"/><DatePicker x:Name="To" Width="135"/>
    <ComboBox x:Name="ShiftFilter" Width="230" Margin="12,0" DisplayMemberPath="Label" SelectedValuePath="Id"/>
    <Button Background="#12634B" Foreground="White" Content="Xem báo cáo" Padding="10,5" Click="Refresh_Click"/><Button Content="Xuất CSV" Padding="10,5" Margin="10,0" Click="Export_Click"/>
   </WrapPanel>

  </StackPanel>
  <TabControl Margin="0,14,0,0">
<TabItem Header="Tổng quan"><ScrollViewer Background="#F3F5F4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14">
<UniformGrid Columns="2">
 <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="Doanh thu bán hàng"/><TextBlock x:Name="RevenueMetric" Style="{StaticResource MetricValue}"/></StackPanel></Border>
 <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="Doanh thu thuần · sau hoàn tiền"/><TextBlock x:Name="NetMetric" Style="{StaticResource MetricValue}"/></StackPanel></Border>
 <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="Đơn đã thanh toán"/><TextBlock x:Name="OrderMetric" Style="{StaticResource MetricValue}"/></StackPanel></Border>
 <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="Giá trị đơn trung bình · trước hoàn"/><TextBlock x:Name="AverageMetric" Style="{StaticResource MetricValue}"/></StackPanel></Border>
</UniformGrid>
<TextBlock x:Name="EmptyReport" Text="Chưa có giao dịch trong khoảng ngày và ca đã chọn." Visibility="Collapsed" Foreground="#52665F" Margin="0,4,0,12"/>
<TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,16"/>
<TextBlock Text="Doanh thu thuần không phải lợi nhuận. Hoàn tiền được tính theo ngày hoàn; thu/chi ngoài bán hàng không cộng vào doanh thu." TextWrapping="Wrap" Foreground="#52665F" Margin="0,0,0,20"/>
<DockPanel><Button DockPanel.Dock="Right" Content="Xuất CSV theo ngày" Click="ExportDaily_Click"/><StackPanel><TextBlock Text="Doanh thu theo ngày" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Tối đa 31 ngày có giao dịch gần nhất trong bộ lọc; CSV gồm toàn bộ ngày có giao dịch. Xanh: bán hàng · Cam: hoàn tiền" TextWrapping="Wrap" Foreground="#52665F" Margin="0,4,12,12"/></StackPanel></DockPanel>
<ItemsControl x:Name="DailyChart"><ItemsControl.ItemTemplate><DataTemplate>
 <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel>
  <DockPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" HorizontalAlignment="Right"/></DockPanel>
  <WrapPanel Margin="0,4,0,0"><TextBlock Text="{Binding SalesLabel}" Foreground="#12634B" Margin="0,0,16,0"/><TextBlock Text="{Binding RefundLabel}" Foreground="#92400E"/></WrapPanel><ProgressBar Value="{Binding SalesPercent, Mode=OneWay}" Maximum="100" Height="12" Foreground="#12634B" Background="#EFF4F1" BorderThickness="0" Margin="0,8,0,4" ToolTip="{Binding SalesLabel}" AutomationProperties.Name="{Binding SalesLabel}"/>
  <ProgressBar Value="{Binding RefundPercent, Mode=OneWay}" Maximum="100" Height="8" Foreground="#B45309" Background="#FFF7ED" BorderThickness="0" ToolTip="{Binding RefundLabel}" AutomationProperties.Name="{Binding RefundLabel}"/>
 </StackPanel></Border>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Top 5 món theo doanh thu · trước hoàn tiền" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12"/>
<ItemsControl x:Name="ProductChart"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,14"><DockPanel><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" HorizontalAlignment="Right"/></DockPanel><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="12" Foreground="#12634B" Background="#EFF4F1" BorderThickness="0" Margin="0,6,0,0" AutomationProperties.Name="{Binding Detail}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Đơn hàng"><Grid><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DataGrid x:Name="Orders" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="OrderSelected"><DataGrid.Columns>
     <DataGridTextColumn Header="STT" Binding="{Binding DailyOrderNumberFormatted}"/><DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/>
     <DataGridTextColumn Header="Phương thức" Binding="{Binding PaymentMethod}"/><DataGridTextColumn Header="Tổng tiền" Binding="{Binding FormattedTotal}" Width="120"/><DataGridTextColumn Header="Mã đơn" Binding="{Binding Id}" Width="*"/>
    </DataGrid.Columns></DataGrid>
    <DataGrid x:Name="Items" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Món" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Tùy chọn" Binding="{Binding OptionsSummary}" Width="*"/><DataGridTextColumn Header="SL" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Thành tiền" Binding="{Binding FormattedTotalPrice}"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Header="Món bán (trước hoàn tiền)"><DataGrid x:Name="TopProducts" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Món" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="120"/><DataGridTextColumn Header="Doanh thu" Binding="{Binding Revenue, StringFormat=N0}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Ca đã đóng"><DataGrid x:Name="Shifts" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Nhân viên" Binding="{Binding CashierName}" Width="*"/><DataGridTextColumn Header="Mở ca" Binding="{Binding StartTime, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Đóng ca" Binding="{Binding EndTime, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Dự kiến" Binding="{Binding ExpectedCash, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="Thực tế" Binding="{Binding ActualCash, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="Chênh lệch" Binding="{Binding Discrepancy, StringFormat=N0}" Width="110"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="Hoàn tiền"><DataGrid x:Name="Refunds" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
    <DataGridTextColumn Header="Ngày hoàn" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="155"/><DataGridTextColumn Header="Tiền hoàn" Binding="{Binding Amount, StringFormat=N0}"/><DataGridTextColumn Header="Phương thức" Binding="{Binding Method}"/><DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="Người duyệt" Binding="{Binding Approver}"/><DataGridTextColumn Header="Mã giao dịch" Binding="{Binding Reference}" Width="140"/>
   </DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Thu/chi tiền mặt"><DataGrid x:Name="CashEntries" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
    <DataGridTextColumn Header="Ngày" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="155"/><DataGridTextColumn Header="Loại" Binding="{Binding TypeLabel}"/><DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}"/><DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="Nhân viên" Binding="{Binding Operator}"/><DataGridTextColumn Header="Người duyệt" Binding="{Binding Approver}"/>
   </DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
 </DockPanel>
</Window>


