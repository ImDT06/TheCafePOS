<Window Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.VietQRModal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chuyển khoản ngân hàng" Height="540" Width="780" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource PosCanvas}">
  <Window.Resources>
    <Style x:Key="DetailLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource PosMuted}"/><Setter Property="Margin" Value="0,0,16,0"/></Style>
    <Style x:Key="DetailValue" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource PosInk}"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Chuyển khoản ngân hàng" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0" />
      <TextBlock x:Name="TxtOrderNumber" Text="Đơn #01" FontSize="13" Foreground="{StaticResource PosMuted}" Margin="0,2,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PosBorder}" BorderThickness="1" CornerRadius="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- QR, or the reason it could not be made -->
        <Border BorderBrush="{StaticResource PosBorder}" BorderThickness="0,0,1,0" Padding="24">
          <Grid>
            <Grid x:Name="QrFrame" Width="240" Height="240"><ProgressBar x:Name="QrLoading" Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="36" Height="36"/><Image x:Name="ImgQR" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Grid>
            <StackPanel x:Name="QrError" Visibility="Collapsed" VerticalAlignment="Center">
              <TextBlock Text="Chưa tạo được mã QR" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PosDanger}" TextAlignment="Center" />
              <TextBlock x:Name="TxtQrError" FontSize="13" Foreground="{StaticResource PosMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <!-- What the customer must transfer -->
        <DockPanel Grid.Column="1" Margin="24,22,24,20" LastChildFill="False">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Số tiền cần chuyển" Style="{StaticResource DetailLabel}" />
            <TextBlock x:Name="TxtAmount" Text="55.000đ" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PosInk}" Margin="0,2,0,16" />
            <Border BorderBrush="{StaticResource PosBorder}" BorderThickness="0,1,0,0" />
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="Ngân hàng" Style="{StaticResource DetailLabel}" />
              <TextBlock x:Name="TxtBank" Grid.Column="1" Style="{StaticResource DetailValue}" />
              <TextBlock Grid.Row="1" Text="Số tài khoản" Style="{StaticResource DetailLabel}" Margin="0,10,16,0" />
              <TextBlock x:Name="TxtAccountNo" Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,10,0,0" />
              <TextBlock Grid.Row="2" Text="Chủ tài khoản" Style="{StaticResource DetailLabel}" Margin="0,10,16,0" />
              <TextBlock x:Name="TxtAccountName" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,10,0,0" />
              <TextBlock Grid.Row="3" Text="Nội dung" Style="{StaticResource DetailLabel}" Margin="0,10,16,0" />
              <TextBlock x:Name="TxtMemo" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" FontFamily="Consolas" FontSize="15" Margin="0,10,0,0" />
            </Grid>
          </StackPanel>
          <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{StaticResource PosWarningSoft}" CornerRadius="6" Padding="12,10">
            <DockPanel>
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource PosWarning}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock x:Name="TxtPaymentStatus" Text="Đang chờ khách chuyển khoản" FontSize="13" Foreground="{StaticResource PosWarningInk}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </DockPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button Content="Quay lại" Height="48" Click="BtnCancel_Click" />
      <TextBlock Grid.Column="1" Text="Đã xem bill của khách: đúng số tiền, đúng người nhận, vừa chuyển?" FontSize="12" Foreground="{StaticResource PosMuted}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" Margin="16,0" />
      <Button x:Name="BtnSimulateSuccess" Grid.Column="2" Content="Xác nhận đã nhận tiền" Height="48" Padding="24,0" Click="BtnSimulateSuccess_Click" Style="{StaticResource PrimaryButton}" />
    </Grid>
  </Grid>
</Window>
