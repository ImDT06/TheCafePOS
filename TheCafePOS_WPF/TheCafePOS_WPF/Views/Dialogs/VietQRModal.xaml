<Window Style="{StaticResource PosWindow}" x:Class="TheCafePOS_WPF.Views.Dialogs.VietQRModal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Thanh Toán VietQR Động" Height="650" Width="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F5F4">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <TextBlock Text="Thanh toán VietQR" VerticalAlignment="Center" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock x:Name="TxtOrderNumber" Text="Mã Đơn: #01" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <!-- QR Display -->
    <Border Grid.Row="1" BorderBrush="#12634B" BorderThickness="1.5" CornerRadius="14" Background="White" Padding="15">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Image x:Name="ImgQR" Width="240" Height="240" Stretch="Uniform" Margin="0,0,0,10"><Image.Style><Style TargetType="Image"><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Image.Style></Image>
          <TextBlock Text="Số tiền thanh toán:" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock x:Name="TxtAmount" Text="55.000đ" FontSize="24" FontWeight="Bold" Foreground="#12634B" HorizontalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock x:Name="TxtPaymentStatus" Text="Chờ xác nhận chuyển khoản" FontSize="13" FontWeight="SemiBold" Foreground="#D97706" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="350" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <!-- Actions -->
    <StackPanel Grid.Row="2" Margin="0,15,0,0">
      <Button x:Name="BtnSimulateSuccess" Height="48" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,0,10" Click="BtnSimulateSuccess_Click" Style="{StaticResource PrimaryButton}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="M 12,22 C 13.1,22 14,21.1 14,20 L 10,20 C 10,21.1 10.9,22 12,22 Z M 18,16 L 18,11 C 18,7.93 16.37,5.36 13.5,4.68 L 13.5,4 C 13.5,3.17 12.83,2.5 12,2.5 C 11.17,2.5 10.5,3.17 10.5,4 L 10.5,4.68 C 7.64,5.36 6,7.92 6,11 L 6,16 L 4,18 L 4,19 L 20,19 L 20,18 L 18,16 Z" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="Quản lý xác nhận đã nhận chuyển khoản" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Button>
      <Button Content="Quay lại đơn hàng" Height="48" Cursor="Hand" Click="BtnCancel_Click" />
    </StackPanel>
  </Grid>
</Window>