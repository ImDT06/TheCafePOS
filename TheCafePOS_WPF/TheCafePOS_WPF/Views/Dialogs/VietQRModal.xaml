<Window x:Class="TheCafePOS_WPF.Views.Dialogs.VietQRModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh Toán VietQR Động" Height="650" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="M 3,3 L 9,3 L 9,9 L 3,9 L 3,3 Z M 5,5 L 7,5 L 7,7 L 5,7 L 5,5 Z M 3,15 L 9,15 L 9,21 L 3,21 L 3,15 Z M 5,17 L 7,17 L 7,19 L 5,19 L 5,17 Z M 15,3 L 21,3 L 21,9 L 15,9 L 15,3 Z M 17,5 L 19,5 L 19,7 L 17,7 L 17,5 Z M 13,13 L 15,13 L 15,15 L 13,15 L 13,13 Z M 19,13 L 21,13 L 21,15 L 19,15 L 19,13 Z M 17,15 L 19,15 L 19,17 L 17,17 L 17,15 Z M 13,17 L 15,17 L 15,19 L 13,19 L 13,17 Z M 15,19 L 17,19 L 17,21 L 15,21 L 15,19 Z M 19,19 L 21,19 L 21,21 L 19,21 L 19,19 Z"
                      Fill="#0284C7" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="THANH TOÁN VIETQR ĐỘNG" FontSize="18" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtOrderNumber" Text="Mã Đơn: #01" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- QR Display -->
        <Border Grid.Row="1" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="10" Background="White" Padding="15">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="ImgQR" Width="240" Height="240" Stretch="Uniform" Margin="0,0,0,10"/>
                <TextBlock Text="Số tiền thanh toán:" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtAmount" Text="55.000đ" FontSize="24" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtPaymentStatus" Text="Đang chờ khách quét mã thanh toán..." FontSize="13" FontWeight="SemiBold" Foreground="#D97706" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <Button x:Name="BtnSimulateSuccess" Height="48" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10" Click="BtnSimulateSuccess_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 12,22 C 13.1,22 14,21.1 14,20 L 10,20 C 10,21.1 10.9,22 12,22 Z M 18,16 L 18,11 C 18,7.93 16.37,5.36 13.5,4.68 L 13.5,4 C 13.5,3.17 12.83,2.5 12,2.5 C 11.17,2.5 10.5,3.17 10.5,4 L 10.5,4.68 C 7.64,5.36 6,7.92 6,11 L 6,16 L 4,18 L 4,19 L 20,19 L 20,18 L 18,16 Z"
                          Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Quản lý xác nhận đã nhận chuyển khoản" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Content="Hủy Thanh Toán" Height="48" Background="#94A3B8" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>


